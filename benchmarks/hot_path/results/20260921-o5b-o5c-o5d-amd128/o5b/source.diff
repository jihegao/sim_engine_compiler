+        let removed: Vec<_> = self
+            .active
+            .keys()
+            .filter(|owner| !desired.contains_key(owner))
+            .copied()
+            .collect();
+        for owner in removed {
+            self.active.remove(&owner);
+            self.bump_generation(owner);
+            update.invalidated += 1;
+        }
+
+        for (&owner, &spec) in desired {
+            if self
+                .active
+                .get(&owner)
+                .is_some_and(|active| active.spec == spec)
+            {
+                continue;
+            }
+            if self.active.remove(&owner).is_some() {
+                update.invalidated += 1;
+            }
+            let generation = self.bump_generation(owner);
+            let sequence = self.next_sequence;
+            self.next_sequence = self.next_sequence.saturating_add(1);
+            let scheduled = ScheduledWake {
+                minute: spec.minute,
+                phase_rank: spec.phase_rank,
+                owner_order: spec.owner_order,
+                sequence,
+                kind: spec.kind,
+                owner,
+                generation,
+            };
+            self.queue.push(Reverse(scheduled));
+            self.active.insert(owner, ActiveWake { spec, scheduled });
+            update.pushed += 1;
+        }
