+    #[test]
+    fn guarded_failure_bulk_advance_matches_repeated_bits_and_due_tick() {
+        let whole_values = [
+            1_u64,
+            2,
+            3,
+            7,
+            31,
+            255,
+            1_023,
+            65_535,
+            1 << 20,
+            1 << 32,
+            1 << 48,
+            (1 << 52) - 2,
+            1 << 52,
+            (1 << 53) - 2,
+            1 << 53,
+        ];
+        for whole in whole_values {
+            for fraction in [0.0, 0.25, 0.5, 0.75] {
+                let remaining = whole as f64 + fraction;
+                for skipped in [1, 2, 3, 7, 31, 255, 4_095] {
+                    if skipped >= failure_ticks_until_due(remaining) {
+                        continue;
+                    }
+                    assert_eq!(
+                        failure_advance_mode(remaining, skipped),
+                        FailureAdvanceMode::Analytic
+                    );
+                    let mut repeated = remaining;
+                    for _ in 0..skipped {
+                        repeated -= 1.0;
+                    }
+                    let bulk = remaining - skipped as f64;
+                    assert_eq!(bulk.to_bits(), repeated.to_bits());
+                    assert_eq!(
+                        skipped + failure_ticks_until_due(bulk),
+                        failure_ticks_until_due(remaining)
+                    );
+                }
+            }
+        }
+    }
