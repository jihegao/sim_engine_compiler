+    #[test]
+    fn job_bulk_advance_matches_repeated_and_rejects_completion() {
+        for remaining in [1, 2, 3, 31, 4_096, i64::MAX] {
+            for skipped in [1, 2, 7, 255, 4_095] {
+                let bulk = job_bulk_remaining(remaining, skipped);
+                if skipped >= remaining {
+                    assert_eq!(bulk, None);
+                    continue;
+                }
+                let mut repeated = remaining;
+                for _ in 0..skipped {
+                    repeated -= 1;
+                }
+                assert_eq!(bulk, Some(repeated));
+            }
+        }
+        assert_eq!(job_bulk_remaining(i64::MIN, 1), None);
+        assert_eq!(job_bulk_remaining(10, 0), None);
+    }
