+fn job_bulk_remaining(remaining: i64, skipped: i64) -> Option<i64> {
+    if skipped <= 0 {
+        return None;
+    }
+    remaining.checked_sub(skipped).filter(|next| *next > 0)
+}
+
+fn failure_advance_mode(remaining: f64, skipped: i64) -> FailureAdvanceMode {
+    if !remaining.is_finite() {
+        FailureAdvanceMode::FallbackNonFinite
+    } else if remaining <= 0.0 || skipped <= 0 || skipped >= failure_ticks_until_due(remaining) {
+        FailureAdvanceMode::FallbackDueGuard
+    } else if remaining > MAX_EXACT_F64_INTEGER {
+        FailureAdvanceMode::FallbackOutOfExactRange
+    } else {
+        FailureAdvanceMode::Analytic
+    }
+}
