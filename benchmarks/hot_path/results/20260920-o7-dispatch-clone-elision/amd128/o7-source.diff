+        let mut plan = transport_plan();
+        plan.resource_nodes[0].inventory = vec![("filter".into(), 0)];
+        let mut runtime = Runtime::from_shared_profiled(
+            Arc::new(plan),
+            "test-fingerprint".into(),
+            0,
+            ObservationLevel::Full,
