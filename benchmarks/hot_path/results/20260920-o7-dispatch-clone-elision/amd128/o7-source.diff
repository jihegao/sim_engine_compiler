+        runtime.minute = 10;
+        runtime.phase = "resource_dispatch".into();
+        runtime.create_job(0, 0, "test", None, None, None).unwrap();
+        let job_index = runtime.jobs.len() - 1;
+        let initial_plan_spec_clones = runtime.profile.plan_spec_clones;
+
+        runtime.phase_start_waiting_jobs().unwrap();
+        runtime.minute += 1;
+        runtime.phase_start_waiting_jobs().unwrap();
+
+        assert_eq!(runtime.profile.supply_route_candidate_visits, 2);
+        assert_eq!(runtime.profile.plan_spec_clones, initial_plan_spec_clones);
+        assert_eq!(runtime.jobs[job_index].state, "waiting");
+        assert!(runtime.shipments.is_empty());
+        assert_eq!(
+            runtime
+                .trace
+                .iter()
+                .filter(|event| event["kind"] == "spare_shortage")
+                .count(),
+            1
+        );
