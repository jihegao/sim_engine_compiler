"""Capture one external source candidate; canonical files never change."""
from pathlib import Path
import datetime as dt, hashlib, json, stat, subprocess, sys, uuid
R=Path(__file__).resolve().parents[1]
C=R/'cases/simlox-air-support/A17-var01-same-station-units-v1.0.0'
F=R/'tmp/a17-var01-root-static-freeze-v101-20261008.json'
assert len(sys.argv)==2 and sys.argv[1] in ('inventory','manifest')
kind=sys.argv[1]
tool,target=('make_source_inventory.py','source-inventory.json') if kind=='inventory' else ('make_prelaunch_manifest.py','prelaunch-manifest.json')
def pin(p):
 b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def sources(rows):
 result={}
 for rel,expected in rows.items():
  p=C/rel;assert p.is_file() and not p.stat().st_mode&stat.S_IWRITE
  result[rel]=pin(p);assert result[rel]==expected,rel
 return result
def canonicals():
 result={}
 for name in ('source-inventory.json','prelaunch-manifest.json'):
  p=C/name
  if p.exists():
   assert p.is_file() and not p.stat().st_mode&stat.S_IWRITE
   result[name]=pin(p)
 return result
def originals(rows):
 result=[]
 for row in rows:
  p=Path(row['path']);s=p.stat();v=pin(p)
  assert v=={k:row[k] for k in ('bytes','sha256')}
  assert s.st_mode==row['original_mode'] and s.st_file_attributes==row['original_attributes']
  result.append({'path':str(p),**v,'mode':s.st_mode,'attributes':s.st_file_attributes})
 return result
assert pin(F)=={'bytes':8770,'sha256':'cfa39ff2c260f8e10e112b4e7d2829b908a4b474a6e8c966d9a87e69be995ad8'}
f=json.loads(F.read_bytes());assert f['schema']=='a17-var01-root-static-freeze/v101'
assert f['native_dispatch'] is False and len(f['case_sources'])==53
before=sources(f['case_sources']);canonical_before=canonicals()
assert set(canonical_before)==(set() if kind=='inventory' else {'source-inventory.json'})
assert not (C/'runs/a17-var01-same-station-v100-ssh-20261008-01').exists()
rows=json.loads((C/'source-maps/prospective-source-pins.json').read_bytes())['mandatory_originals']
assert len(rows)==61
raw_before=originals(rows)
O=R/'tmp/a17-var01-root-source-candidates-v100-20261008'/(kind+'-'+dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')+'-'+uuid.uuid4().hex[:8])
O.mkdir(parents=True,exist_ok=False)
candidate=O/target
argv=[sys.executable,'-X','utf8','-B',str(C/tool),'--candidate',str(candidate)]
started=dt.datetime.now(dt.timezone.utc).isoformat()
with (O/'stdout.bin').open('xb') as so,(O/'stderr.bin').open('xb') as se:
 code=subprocess.run(argv,cwd=R,stdout=so,stderr=se).returncode
failure=None;after=None;canonical_after=None;raw_after=None
try:
 after=sources(f['case_sources']);canonical_after=canonicals();raw_after=originals(rows)
 assert after==before and canonical_after==canonical_before and raw_after==raw_before
 assert type(code) is int and code==0 and (O/'stderr.bin').read_bytes()==b''
 assert candidate.is_file()
 doc=json.loads(candidate.read_bytes())
 if kind=='inventory':assert doc['source_count']==len(doc['source_files'])==53
 else:assert doc['owned_source_count']==54 and doc['source_count']==len(doc['source_files'])==173
except BaseException as e:failure=type(e).__name__+': '+str(e)
record={'schema':'a17-var01-root-source-candidate/v100','kind':kind,'native_dispatch':False,'ssh_dispatch':False,'canonical_mutation':False,'argv':argv,'started_utc':started,'completed_utc':dt.datetime.now(dt.timezone.utc).isoformat(),'actual_exit':code,'freeze_record':pin(F),'case_sources_before':before,'case_sources_after':after,'canonical_before':canonical_before,'canonical_after':canonical_after,'mandatory_originals_before':raw_before,'mandatory_originals_after':raw_after,'candidate':{'path':str(candidate),**pin(candidate)} if candidate.is_file() else None,'streams':{n:pin(O/n) for n in ('stdout.bin','stderr.bin')},'decision':'PASS_EXTERNAL_CANDIDATE_ONLY' if failure is None else 'NO_GO_PRESERVED','failure':failure}
with (O/'receipt.json').open('xb') as file:file.write((json.dumps(record,indent=2)+'\n').encode())
for p in O.iterdir():p.chmod(stat.S_IREAD)
print(json.dumps({'receipt':str(O/'receipt.json'),**pin(O/'receipt.json'),'kind':kind,'actual_exit':code,'decision':record['decision'],'candidate':record['candidate'],'failure':failure}))
assert failure is None
