"""Capture original binary streams from the read-only independent audit."""
import hashlib
import json
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
AUDIT = HERE / "i03-var05-independent-pure-preflight-audit-20261008.py"
OUT = HERE / "i03-var05-independent-pure-preflight-proof-20261008-01"
assert not OUT.exists()
OUT.mkdir()
before = AUDIT.read_bytes()
proc = subprocess.run([sys.executable, "-X", "utf8", "-B", str(AUDIT)],
                      cwd=HERE.parent, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
(OUT / "stdout.bin").write_bytes(proc.stdout)
(OUT / "stderr.bin").write_bytes(proc.stderr)
after = AUDIT.read_bytes()
assert before == after
receipt = {
    "schema": "i03-var05-independent-pure-preflight-proof/v1",
    "auditor": {"bytes": len(before), "sha256": hashlib.sha256(before).hexdigest()},
    "argv": [sys.executable, "-X", "utf8", "-B", str(AUDIT)],
    "actual_exit": proc.returncode,
    "stdout": {"bytes": len(proc.stdout), "sha256": hashlib.sha256(proc.stdout).hexdigest()},
    "stderr": {"bytes": len(proc.stderr), "sha256": hashlib.sha256(proc.stderr).hexdigest()},
    "decision": json.loads(proc.stdout)["decision"] if proc.returncode == 0 else "NO_GO",
    "native_calls": 0,
}
(OUT / "receipt.json").write_bytes((json.dumps(receipt, sort_keys=True, indent=2) + "\n").encode())
print(json.dumps(receipt, sort_keys=True))
