"""Capture the frozen independent replay against only the original sealed child run."""
import hashlib
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CASE = REPO / "cases/simlox-air-support/I03-var05-in-zero-delay-v1.0.0"
RUN_ID = "i03-var05-in-zero-delay-v100-ssh-20261008-01"
RUN = CASE / "runs" / RUN_ID
READER = CASE / "review/independent_replay.py"
OUT = REPO / "tmp/i03-var05-independent-postrun-capture-20261008-01"
assert RUN.is_dir() and not OUT.exists()
files = sorted((p for p in RUN.iterdir() if p.is_file()), key=lambda p: p.name)
assert len(files) == 25


def pin(path):
    data = path.read_bytes()
    return {"bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


before = {p.name: pin(p) for p in files}
method_before = pin(READER)
manifest_before = pin(CASE / "prelaunch-manifest.json")
approval_before = pin(CASE / "review/independent-prelaunch-go.json")
OUT.mkdir()
proc = subprocess.run([sys.executable, "-X", "utf8", "-B", str(READER)], cwd=CASE,
                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
(OUT / "stdout.bin").write_bytes(proc.stdout)
(OUT / "stderr.bin").write_bytes(proc.stderr)
after = {p.name: pin(p) for p in files}
assert before == after and method_before == pin(READER)
assert manifest_before == pin(CASE / "prelaunch-manifest.json")
assert approval_before == pin(CASE / "review/independent-prelaunch-go.json")
try:
    verdict = json.loads(proc.stdout) if proc.returncode == 0 else None
except ValueError:
    verdict = None
receipt = {
    "schema": "i03-var05-independent-postrun-capture/v1",
    "reader": method_before,
    "manifest": manifest_before,
    "approval": approval_before,
    "original_run_files": before,
    "actual_exit": proc.returncode,
    "stdout": {"bytes": len(proc.stdout), "sha256": hashlib.sha256(proc.stdout).hexdigest()},
    "stderr": {"bytes": len(proc.stderr), "sha256": hashlib.sha256(proc.stderr).hexdigest()},
    "verdict": verdict,
    "new_native_calls": 0,
}
(OUT / "receipt.json").write_bytes((json.dumps(receipt, sort_keys=True, indent=2) + "\n").encode())
print(json.dumps({k: receipt[k] for k in ("schema", "actual_exit", "stdout", "stderr", "verdict")},
                 sort_keys=True))
