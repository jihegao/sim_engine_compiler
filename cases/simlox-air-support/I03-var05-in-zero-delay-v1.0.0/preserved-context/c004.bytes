"""Construct the prospective I03.var05 contract design without creating a case."""
from __future__ import annotations

import hashlib
import json
import struct
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CASE_ROOT = ROOT / "cases/simlox-air-support"
PARENT = CASE_ROOT / "I03-var01-crew-out-in-v1.0.0"
PARENT_INPUT = PARENT / "out_in-input.json"
PARENT_RUN = PARENT / "runs/i03-var01-crew-transfer-v100-ssh-20261005-01"
PARENT_INDEX = PARENT / "evidence-index.json"
SELECTION = ROOT / "tmp/i03-var05-root-selection-20261008.json"
VAR03_CONTRACT = CASE_ROOT / "I03-var03-matched-crew-out-batch-v1.0.0/contract.json"
OUT = ROOT / "tmp/i03-var05-prospective-contract-design-v2-20261008.json"
ENGINE = Path(r"C:\Program Files\Systecon\SIMLOX\Simlox.exe")


def pin(path: Path) -> dict:
    data = path.read_bytes()
    return {"path": str(path.relative_to(ROOT)).replace("\\", "/"),
            "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def f32(value: float) -> float:
    return struct.unpack("<f", struct.pack("<f", value))[0]


selection = json.loads(SELECTION.read_text(encoding="utf-8"))
parent_model = json.loads(PARENT_INPUT.read_text(encoding="utf-8"))["model"]
tables = parent_model["tables"]
by_name = {t["name"]: t for t in tables}
template_gate = json.loads(VAR03_CONTRACT.read_text(encoding="utf-8"))["report_gate"]
assert len(tables) == 32 and len(by_name) == 32
assert sum(len(t["instances"][0]["rows"]) for t in tables) == 25
assert sum(len(t["instances"][0]["rows"]) * len(t["columns"]) for t in tables) == 227
assert len(selection["parent_source_disk_git"]) == 17
assert len(selection["prerequisite_source_disk_git"]) == 63
assert len(selection["mandatory_original_raw"]) == 112
assert selection["catalog_entries"] == 494
transfer = by_name["ResourceTransfer"]
transfer_fields = [c["name"] for c in transfer["columns"]]
assert transfer_fields == ["STFID", "STTID", "RID", "TFTIME", "TFQTY", "TFDT", "NOTE"]
assert transfer["instances"][0]["rows"] == [
    ["BASE-01", "<OUTSIDE>", "P-CREW", 7.75, 1, 0.0, None],
    ["<OUTSIDE>", "BASE-01", "P-CREW", 10.0, 1, 0.5, None],
]
assert by_name["ProblemDescription"]["instances"][0]["rows"] == [
    ["I03.var01 out_in: second formation at h20; crew transfer comparison"]]
assert by_name["ResourceAllocation"]["instances"][0]["rows"] == [
    ["AIR_BASIC", "P-CREW", "BASE-01", 2, None]]

system_classes = template_gate["system_field_classes"]
stock_fields = template_gate["stock_fields"]
resource_classes = {k: template_gate["resource_fields"][k] for k in
                    ("identity_and_interval", "source_event_dynamic", "source_event_zero")}
topology = template_gate["topology"]
assert [t["name"] for t in topology] == [
    "ProblemDescription", "ResultSummary", "SystemResults", "StockTotalResults",
    "ResourceResults", "ResourceResultsTotal"]
assert sum(t["rows"] * len(t["columns"]) for t in topology) == 5210
assert set(sum((v for v in system_classes.values()), [])) == set(topology[2]["columns"])
assert set(sum((v for v in stock_fields.values()), [])) == set(topology[3]["columns"])
assert set(sum((v for v in resource_classes.values()), [])) == set(topology[4]["columns"])

