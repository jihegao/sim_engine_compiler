"""Read-only postappend portability check of the unchanged frozen reader."""
import hashlib
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CASE = REPO / "cases/simlox-air-support/I03-var05-in-zero-delay-v1.0.0"
RUN = CASE / "runs/i03-var05-in-zero-delay-v100-ssh-20261008-01"
READER = CASE / "review/independent_replay.py"
EARLIER = REPO / "tmp/i03-var05-independent-postrun-capture-20261008-01/stdout.bin"
OUT = REPO / "tmp/i03-var05-independent-postappend-replay-20261008-01"
assert RUN.is_dir() and not OUT.exists()


def pin(path):
    data = path.read_bytes()
    return {"bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


files = {p.name: pin(p) for p in RUN.iterdir() if p.is_file()}
assert len(files) == 25
method = pin(READER)
catalog = pin(REPO / "cases/simlox-air-support/publication-index-v1.json")
OUT.mkdir()
proc = subprocess.run([sys.executable, "-X", "utf8", "-B", str(READER)], cwd=CASE,
                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
(OUT / "stdout.bin").write_bytes(proc.stdout)
(OUT / "stderr.bin").write_bytes(proc.stderr)
assert files == {p.name: pin(p) for p in RUN.iterdir() if p.is_file()}
assert method == pin(READER)
assert catalog == pin(REPO / "cases/simlox-air-support/publication-index-v1.json")
assert proc.returncode == 0 and proc.stderr == b""
current = json.loads(proc.stdout)
prior = json.loads(EARLIER.read_bytes())
assert current == prior and proc.stdout == EARLIER.read_bytes()
assert current["decision"] == "GO_BOUNDED" and current["checks"] == 70095
receipt = {
    "schema": "i03-var05-independent-postappend-replay/v1",
    "actual_exit": proc.returncode,
    "reader": method,
    "live_catalog_495": catalog,
    "original_run_file_count": len(files),
    "original_run_files_unchanged": True,
    "stdout": pin(OUT / "stdout.bin"),
    "stderr": pin(OUT / "stderr.bin"),
    "typed_verdict_equal": True,
    "stdout_byte_equal": True,
    "checks": current["checks"],
    "new_native_calls": 0,
}
(OUT / "receipt.json").write_bytes((json.dumps(receipt, sort_keys=True, indent=2) + "\n").encode())
print(json.dumps(receipt, sort_keys=True))
