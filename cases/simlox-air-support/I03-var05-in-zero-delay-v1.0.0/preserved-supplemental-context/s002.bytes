"""Capture original stdout/stderr from the direct postrun byte audit."""
import hashlib
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
AUDIT = REPO / "tmp/i03-var05-independent-postrun-audit-20261008.py"
OUT = REPO / "tmp/i03-var05-independent-postrun-audit-proof-20261008-01"
assert not OUT.exists()
OUT.mkdir()
before = AUDIT.read_bytes()
proc = subprocess.run([sys.executable, "-X", "utf8", "-B", str(AUDIT)], cwd=REPO,
                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
(OUT / "stdout.bin").write_bytes(proc.stdout)
(OUT / "stderr.bin").write_bytes(proc.stderr)
assert before == AUDIT.read_bytes()
receipt = {
    "schema": "i03-var05-independent-postrun-audit-proof/v1",
    "auditor": {"bytes": len(before), "sha256": hashlib.sha256(before).hexdigest()},
    "actual_exit": proc.returncode,
    "stdout": {"bytes": len(proc.stdout), "sha256": hashlib.sha256(proc.stdout).hexdigest()},
    "stderr": {"bytes": len(proc.stderr), "sha256": hashlib.sha256(proc.stderr).hexdigest()},
    "decision": json.loads(proc.stdout)["decision"] if proc.returncode == 0 else "NO_GO",
    "new_native_calls": 0,
}
(OUT / "receipt.json").write_bytes((json.dumps(receipt, sort_keys=True, indent=2) + "\n").encode())
print(json.dumps(receipt, sort_keys=True))
