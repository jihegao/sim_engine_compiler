"""Read-only audit of the one actual SSH5 zero-native preflight and seal."""
from pathlib import Path
import hashlib
import importlib.util
import json
import stat

ROOT = Path(__file__).resolve().parents[1]
CASE = ROOT / "cases/simlox-air-support/I04-var03-idle-system-between-v1.0.1"
PREF = CASE / "review/preflight-ssh0-20261008T054617008Z.json"
ROOT_RECEIPT = ROOT / "tmp/i04-var03-root-phases-v101-20261008/preflight-20261008T054557756174Z-20731187/receipt.json"
SEAL = ROOT / "tmp/i04-var03-root-preflight-seal-v101-20261008/20261008T054623786660Z-cd430084/receipt.json"
TRANSPORT = CASE / "transport-evidence/ssh-preflight-20261008T054557845177Z-3a90818b/transport-receipt.json"
PREF_SHA = "36434b4888d6fdf10d5463ac51087a6365174b84564ea0c0886e777d06fe16f4"
MANIFEST_SHA = "d05541613248279a5620349ade72bcaf80b12f3be042b470694f45b6efa690f3"
SOURCE_MAP_SHA = "d9085c3fe63ced6473507f483f7c55dfb91f8181f2ef0cc4e32a47b28c1aad8e"

def pin(path):
    blob = path.read_bytes()
    return {"bytes": len(blob), "sha256": hashlib.sha256(blob).hexdigest()}

spec = importlib.util.spec_from_file_location("independent_v101_reader", CASE / "review/independent_replay.py")
reader = importlib.util.module_from_spec(spec)
spec.loader.exec_module(reader)
assert pin(CASE / "prelaunch-manifest.json")["sha256"] == MANIFEST_SHA
manifest = reader.strict_json((CASE / "prelaunch-manifest.json").read_bytes())
source_map, source_sha = reader.verify_manifest_document(manifest, final=True)
assert len(source_map) == 456 and source_sha == SOURCE_MAP_SHA
receipt = reader.verify_preflight(PREF, PREF_SHA, manifest, source_map, source_sha)
assert pin(PREF) == {"bytes": 133684, "sha256": PREF_SHA}
assert receipt["native_process_started"] is False
outer = reader.strict_json(ROOT_RECEIPT.read_bytes())
assert outer["schema"] == "issue18-i04-var03-root-phase-transport/v1"
assert outer["action"] == "preflight" and outer["native_dispatch"] is False
assert outer["expected_run_id"] == reader.RUN_ID and outer["run_exists_after"] is False
reader.integer(outer["actual_exit"], 0)
assert outer["error"] is None and reader.typed(outer["method_before"], outer["method_after"])
for stream in ("stdout.bin", "stderr.bin"):
    assert outer["streams"][stream] == pin(ROOT_RECEIPT.parent / stream)
reader.integer(outer["streams"]["stderr.bin"]["bytes"], 0)
ssh = reader.strict_json(TRANSPORT.read_bytes())
assert ssh["mode"] == "preflight" and ssh["run_id"] == reader.RUN_ID
assert ssh["native_approved"] is False and ssh["manifest_sha256"] == MANIFEST_SHA
reader.integer(ssh["exit_code"], 0)
assert ssh["error"] is None and set(ssh["streams"]) == {"ssh-stdout.bin", "ssh-stderr.bin"}
for name, record in ssh["streams"].items():
    assert pin(TRANSPORT.parent / name) == record
reader.integer(ssh["streams"]["ssh-stderr.bin"]["bytes"], 0)
sealed = reader.strict_json(SEAL.read_bytes())
assert sealed["schema"] == "issue18-i04-var03-root-preflight-seal/v1"
assert sealed["run_id"] == reader.RUN_ID and sealed["historical_attributes_changed"] is False
reader.integer(sealed["original_count"], 15)
reader.integer(sealed["native_calls"], 0)
paths = [Path(row["path"]) for row in sealed["original_files"]]
assert len(paths) == len(set(paths)) == 15
expected = {PREF, Path(receipt["pure_proof_path"]), TRANSPORT,
            *(Path(check[kind + "_path"]) for check in receipt["pure_checks"] for kind in ("stdout", "stderr")),
            TRANSPORT.parent / "ssh-stdout.bin", TRANSPORT.parent / "ssh-stderr.bin"}
assert set(paths) == expected
for row, path in zip(sealed["original_files"], paths):
    assert path.is_file() and path.is_relative_to(CASE) and not path.is_symlink()
    assert pin(path) == {"bytes": row["bytes"], "sha256": row["sha256"]}
    assert row["read_only"] is True and not path.stat().st_mode & stat.S_IWUSR
assert not (CASE / "runs" / reader.RUN_ID).exists()
assert not (CASE / "review/independent-prelaunch-go.json").exists()
print(json.dumps({"decision": "GO_PRELAUNCH", "preflight_sha256": PREF_SHA,
                  "manifest_sha256": MANIFEST_SHA, "source_map_sha256": SOURCE_MAP_SHA,
                  "pure_checks": 5, "sealed_originals": 15, "native_calls": 0}, sort_keys=True))
