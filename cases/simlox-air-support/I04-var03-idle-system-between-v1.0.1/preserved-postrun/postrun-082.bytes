"""Read-only append fixture for the v101 source and manifest builders."""
from __future__ import annotations

import copy
import json
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PKG = ROOT / "cases/simlox-air-support/I04-var03-idle-system-between-v1.0.1"
import sys
sys.path.insert(0, str(PKG))
import source_gate
import make_prelaunch_manifest
from model_common import parse

baseline = make_prelaunch_manifest.body(make_prelaunch_manifest.candidate(True, "sealed"))
original_live = source_gate.CAT_LIVE
document = parse(original_live.read_bytes())
assert len(document["entries"]) == 496
new_entry = copy.deepcopy(document["entries"][-1])
new_entry["publication_id"] = "I04.var03.synthetic_append_probe"
document["entries"].append(new_entry)
with tempfile.TemporaryDirectory(prefix="i04-var03-v101-catalog-", dir=ROOT / "tmp") as work:
    target = Path(work) / "publication-index-v1.json"
    target.write_bytes((json.dumps(document, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))
    source_gate.CAT_LIVE = target
    stable = make_prelaunch_manifest.body(make_prelaunch_manifest.candidate(True, "sealed"))
    assert stable == baseline
    document["entries"][0]["publication_id"] = "corrupt-prefix"
    target.write_bytes((json.dumps(document, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))
    rejected = False
    try:
        make_prelaunch_manifest.candidate(True, "sealed")
    except AssertionError:
        rejected = True
    assert rejected
source_gate.CAT_LIVE = original_live
print(json.dumps({"schema": "i04-var03-v101-catalog-prefix-pure/v1",
                  "historical_entries": 496, "simulated_live_entries": 497,
                  "manifest_bytes_stable": True, "prefix_mutation_rejected": True,
                  "native_calls": 0}, sort_keys=True))
