"""Root read-only actual SSH identity and mutex observation; no native child."""
from pathlib import Path
import datetime as dt, hashlib, json, stat, subprocess, uuid
R=Path(__file__).resolve().parents[1]
G=R/'tmp/issue18-next-owner-guard-20261008.ps1'
def pin(p):
 b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
assert pin(G)['sha256']=='e50559f262d708afd1bd261986089ca807af1c80624d87a8c2c3c5fa4b04077f'
assert not (R/'cases/simlox-air-support/I04-var03-idle-system-between-v1.0.1/runs/i04-var03-idle-system-between-v101-ssh-20261008-01').exists()
O=R/'tmp/i04-var03-root-guards-v101-20261008'/(dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')+'-'+uuid.uuid4().hex[:8])
O.mkdir(parents=True,exist_ok=False)
argv=['ssh','-n','-o','BatchMode=yes','-o','ConnectTimeout=10','-i','C:/Users/user/.ssh/id_rsa','user@127.0.0.1','powershell.exe','-NoProfile','-NonInteractive','-File',G.as_posix()]
started=dt.datetime.now(dt.timezone.utc).isoformat()
with (O/'stdout.bin').open('xb') as out,(O/'stderr.bin').open('xb') as err:
 code=subprocess.run(argv,cwd=R,stdout=out,stderr=err).returncode
d={'schema':'issue18-i04-var03-root-guard-capture/v1','argv':argv,'actual_exit':code,'started_utc':started,'completed_utc':dt.datetime.now(dt.timezone.utc).isoformat(),'root_method':pin(Path(__file__)),'guard_method':pin(G),'streams':{n:pin(O/n) for n in ['stdout.bin','stderr.bin']},'new_native_calls':0}
(O/'receipt.json').write_bytes((json.dumps(d,indent=2)+'\n').encode())
for p in O.iterdir():p.chmod(stat.S_IREAD)
Path(__file__).chmod(stat.S_IREAD)
print(json.dumps({'receipt':str(O/'receipt.json'),**pin(O/'receipt.json'),'actual_exit':code}))
assert type(code) is int and code==0 and (O/'stderr.bin').stat().st_size==0
v=json.loads((O/'stdout.bin').read_bytes().decode('utf-8-sig'));print(json.dumps(v))
assert v['ssh_present'] is True and v['sshd_ancestor'] is True
assert type(v['self_session']) is int and v['self_session']==0
assert type(v['powershell_major']) is int and v['powershell_major']==5
assert v['mutex_free'] is True and v['runner_candidates']==[]
assert v['session_query_exit']==0 and v['active_gui_session1_count']==1
assert len(v['native'])==1
n=v['native'][0]
assert n['pid']==13340 and n['session']==1 and n['start_ms']==1790590196826 and n['responding'] is True
