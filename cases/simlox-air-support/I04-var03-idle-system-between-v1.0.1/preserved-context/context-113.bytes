def require_core_owned(paths):
    assert type(paths) is list and len(paths) == len(CLOSED_OWNED)
    assert all(type(path) is str for path in paths)
    assert len(paths) == len(set(paths)) and set(paths) == CLOSED_OWNED, "owned source closed set differs"
    return True


