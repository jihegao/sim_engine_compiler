  "accepted_publications": [
    {
      "publication_id": "I04.var01.system_between_explicit_units.1.0.0",
      "case_id": "I04",
      "variant_id": "I04.var01",
      "version": "1.0.0",
      "package": "I04-var01-system-between-v1.0.0",
      "evidence": "I04-var01-system-between-v1.0.0/cli-scope-signoff-2026-10-05.md",
      "scope": "Bounded fixed-seed SystemTransfer BETWEEN from accepted A17 two-unit group model, with A02/D03/D09 instructional pins. Both arms schedule group missions h8-10 and h20-22. The transfer arm requests TEACH-AIR-01,0 from TEACH-UNIT/BASE-01 to TEACH-UNIT-2/BASE-02 at h8.5 with TFDT0.5 while the first mission is active; the request time is source-frozen rather than separately logged. Native events show the same aircraft transfer out only after returning ready at h10 and transfer in at h10.5. The target has two distinct ready aircraft; both serve the h20 group mission. Aggregate SystemResults shows one in-unit system during transit h10-10.5 and two after arrival, with successful missions, zero failures/damage, terminal two ready. Both 16 row-containing authored-table roundtrips exact, including all-null control placeholder and null TFPRI; 8 guarded SSH0 steps, converter Errors0/Warnings108+126/Notes0, 22 local raw SHA seals, author109/109 and independent439/439 bounded GO. One seed/two explicit units/one system type/BETWEEN only; IN/OUT, PM retention, transfer priority, shortages, implicit units, GUI/cross-engine and full I04 or Issue #18 unverified. Native reports each have one trailing comma normalized only in memory for analysis."
    },
    {
      "publication_id": "A17.two_units.1.0.0",
      "case_id": "A17",
      "version": "1.0.0",
      "package": "A17-multi-unit-group-v1.0.0",
      "evidence": "A17-multi-unit-group-v1.0.0/cli-scope-signoff-2026-09-29.md",
      "scope": "two explicit units each supplying one aircraft to a formation"
    },
    {
      "publication_id": "A02.repeated.1.0.0",
      "case_id": "A02",
      "version": "1.0.0",
      "package": "A02-single-aircraft-repeated-missions",
      "evidence": "A02-single-aircraft-repeated-missions/cli-scope-signoff-2026-09-29.md",
      "scope": "one aircraft across three nonoverlapping missions"
    },
    {
      "publication_id": "D03.calendar_pm.1.0.0",
      "case_id": "D03",
      "version": "1.0.0",
      "package": "D03-calendar-pm-v1.0.0",
      "evidence": "D03-calendar-pm-v1.0.0/cli-scope-signoff-2026-09-30.md",
      "scope": "one aircraft, two nonconflicting one-hour PMs triggered by a 24-calendar-hour interval"
    },
    {
      "publication_id": "D09.var01.calendar_vs_operational_ncftl_pending_repair.1.0.0",
      "case_id": "D09",
      "variant_id": "D09.var01",
      "version": "1.0.0",
      "package": "D09-var01-calendar-vs-operational-v1.0.0",
      "evidence": "D09-var01-calendar-vs-operational-v1.0.0/cli-scope-signoff-2026-10-02.md",
      "scope": "bounded fixed-seed traditional-LRU Item.NCFTL0.2 clock contrast from accepted D08.var03 CRIT0 parent with accepted E02 zero-stock precedent: both arms set local STSIZ0, differ only Item.NCFTT CALENDAR versus OPERATION plus description, and share h9.8829 noncritical fault, h10 first-mission success and pending SURP/backorder; calendar escalates while idle h10.0829, removes and repairs the same physical LRU ID0, clears backorder h11.3329 and completes all three missions; operational waits across idle, allocates second mission h19, starts h20, escalates/aborts h20.0829, resumes critical repair after return, clears same-item backorder h21.4158 and succeeds at h34; 72 aligned System/Stock bins per arm reconcile one failure/repair/demand, 1.3329 versus 11.4158 item-hour backorder occupancy, terminal ready1/backorder0 and mission success1 versus2/3; two guarded session0 SSH runs, 18 authored-table exact roundtrips each, zero converter errors/warning108 only, 24 local raw seals, author76/76 and independent1640/1640 GO; one seed/item/aircraft/0.2h/zero-stock waiting path only, no MAXNC, active-maintenance, alternate supply, GUI-only or cross-engine claim"
    }
  ],
