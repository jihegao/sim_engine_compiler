"""One-shot original-byte capture of the independent contract audit."""
import hashlib
import json
import subprocess
import sys
from pathlib import Path

root=Path(__file__).resolve().parent.parent
script=root/'tmp/i04-var03-independent-contract-audit-v4.py'
out=root/'tmp/i04-var03-independent-contract-proof-20261008-01'
out.mkdir(exist_ok=False)
before=script.read_bytes()
p=subprocess.run([sys.executable,'-B',str(script)],cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
(out/'stdout.bin').write_bytes(p.stdout)
(out/'stderr.bin').write_bytes(p.stderr)
after=script.read_bytes()
def pin(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
receipt={'schema':'i04-var03-independent-contract-proof/v1','script':str(script),'script_before':pin(before),'script_after':pin(after),'stdout':pin(p.stdout),'stderr':pin(p.stderr),'exit_code':p.returncode,'native_started':False}
(out/'receipt.json').write_text(json.dumps(receipt,sort_keys=True,indent=2)+'\n',encoding='utf-8')
print(json.dumps(receipt,sort_keys=True))
if p.returncode or p.stderr or before!=after:raise SystemExit(1)
