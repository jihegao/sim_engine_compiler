"""Capture exact original streams from one read-only frozen independent replay."""
import hashlib
import json
from pathlib import Path
import subprocess

ROOT=Path(__file__).resolve().parent.parent
PKG=ROOT/'cases/simlox-air-support/I03-var08-idle-at-maxut-out-v1.0.0'
OUT=ROOT/'tmp/i03-var08-independent-sealed-native-20261008-01'
assert not OUT.exists()
OUT.mkdir()
PY=Path(r'C:\Users\user\.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe')
METHOD=PKG/'review/independent_replay.py'
def pin(data): return {'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}
argv=[str(PY),'-X','utf8','-B',str(METHOD)]
r=subprocess.run(argv,cwd=PKG,capture_output=True)
(OUT/'stdout.bin').write_bytes(r.stdout)
(OUT/'stderr.bin').write_bytes(r.stderr)
doc={'schema':'i03-var08-independent-sealed-native-capture/v1','argv':argv,
     'method':pin(METHOD.read_bytes()),'actual_exit':r.returncode,
     'stdout':pin(r.stdout),'stderr':pin(r.stderr)}
body=(json.dumps(doc,indent=2)+'\n').encode()
(OUT/'receipt.json').write_bytes(body)
print(json.dumps({'actual_exit':r.returncode,'receipt_sha256':hashlib.sha256(body).hexdigest(),
                  'stdout':doc['stdout'],'stderr':doc['stderr']},sort_keys=True))
assert r.returncode==0 and not r.stderr
