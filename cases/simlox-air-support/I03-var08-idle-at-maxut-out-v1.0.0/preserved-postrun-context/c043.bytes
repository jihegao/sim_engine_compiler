  },
  "native_protocol": {
    "six_serial_stages": [
      "import",
      "export",
      "type_sensitive_roundtrip_check",
      "calculate",
      "json_report",
      "behavior_check"
    ],
    "converter_after_calc_before_report": {
      "errors": 0,
      "warnings": 2,
      "notes": 0,
      "ordered_exact": [
        [
          "Control",
          "rec 1: (warning #108) Enabling simulation log may generate extensive data in log file"
        ],
        [
          "System",
          "rec 1: (warning #126) This system contains no items: TEACH-AIR-01"
        ]
      ],
      "rule": "Exact whole lines once each, no extra error/warning/note or wrong Form owner. Bind Input file, Output file and File to new run model.sxi/model.sxo. Seal converter log immediately after natural calc completion before report; preserve original binary streams and actual integer exits."
    },
    "future_run_rule": "Root sole serial session-0 SSH invoking PowerShell 5 -File with authenticated sshd ancestry, actual integer exits, fresh GUI/session/PID/start/WTS/mutex guard and unique absent run ID. Separate actual zero-native preflight, independent GO_PURE and GO_PRELAUNCH. No native call before these. Preserve all raw and failure streams, never terminate a child or rerun accepted parent/helper."
  },
  "event_hypothesis": {
    "accepted_parent_edges": [
      23.0,
      23.5,
      24.5,
      25.0,
      26.0,
      28.0,
      29.0,
      36.0
    ],
    "new_exact_edge": 24.75,
    "parent_h24_5": "Two distinct one-hour preparation subtasks complete/release one crew each; available-now snapshots 1 then2; first release prints remaining MAXUT0. Both crew idle before h25. No later crew work.",
    "positive_GO_outcome": "At h24.75 exactly one typed positive quantity-one P-CREW OUT task from BASE-01 is created, demand arrives, starts with printed transfer time0, and arrives. No zero-quantity task, backorder, duplicate task, second decrement, later arrival, crew booking, or altered mission.",
    "adverse_NO_GO_alternatives": "No start/arrival at h24.75, wait to h26 or later, backorder despite two idle local crew, a shift-created replacement crew, changed mission, or any unpredicted line/report value. Preserve native bytes and classify against frozen hypothesis rather than fitting expectations.",
    "microstate_equations": [
      "local=opening2-departed_OUT",
      "physical_idle=local-booked_for_prep-reserved_OUT",
      "requested1=started1=arrived1, pending0",
      "nominal2->1 at h24.75 request; physical local2->1 exactly once at positive departure; arrival cannot decrement again"
    ],
    "free_quantity_distinction": "physical_idle is the unbooked local roster quantity and is not the printed shift Free resources snapshot or a claim about remaining MAXUT budget. Parent closes shift at h25 with local2/physical_idle2 but printed Free resources0, then opens h26 with printed2. Prospective child should show local1/physical_idle1 but printed shift-free0 at h25 and printed1 at h26; same-time resource deallocation available-now and shift snapshots are classified by their own clocks. NRA report remains a separately declared bounded native convention.",
    "shift_clock": "First 23-25 shift MAXUT1 pooled over2 crew; two crew-hours worked 23.5-24.5 and zero remaining budget printed. At h24.75 crew are unbooked. Transfer requires no work and should not wait for 26 reset. After transfer later shift budget is smaller but no subsequent crew work measures a general budget law.",
    "mission_clock": "Two aircraft prepare 23.5-24.5, mission flies28-29 and succeeds, ready2 terminal; no failure/damage/maintenance/stock movements.",
    "terminal": {
      "local_crew": 1,
      "nominal_crew": 1,
      "booked": 0,
      "reserved_OUT": 0,
      "backorder": 0,
      "pending_OUT": 0,
      "ready_aircraft": 2
    },
    "closed_log": "Parse all timed and untimed lines with exact typed owner/quantity/time/sequence and bounded padding only. Accepted parent events remain ordered; only one linked transfer lifecycle is added. Reject unknown, extra, missing, duplicate, wrong-owner, moved-time or contradictory diagnostic/queue/free/shift lines. Parent and child original raw hashes remain separate."
  },
