  "manual": {
    "pdf_sha256": "39427027c46809a9ce9ebcb9be04e7396d96746e42a6f8c7c0ba2ddc294ef8a3",
    "p225_226": "Idle resource may transfer despite reaching maximum utilization; transfer requests outrank ordinary demands; reducing nominal quantity increases later limit risk. This is documented expectation, not observed child behavior.",
    "p422_423": "ShiftResource.MAXUT is pooled per-resource shift usage limit; ongoing work stops at limit and utilization resets at next shift/no-shift. ResourceStationData.MUTILF does not apply during shifts.",
    "p477_479": "ResourceTransfer OUT uses STTID <OUTSIDE>; STFID/STTID/RID/TFTIME keys, TFQTY positive integer and TFDT nonnegative hours. ResourceTransfer has no TFPRI.",
    "p751_760": "NR physical, NRN nominal, NRA shift-available/report state, NRUM work and NRW waiting/time means are distinct. NRA=2 at parent h24.5-25 despite logged MAXUT remaining0; NRA is not a remaining-budget measurement."
  },
  "source_delta": {
    "old_pdesc": "C08 exact MAXUT limit at preparation completion; DRAOS=N",
