"""Draft finite A17.var06 custody candidates; never dispatch native or checkers.

Only explicit --raw-candidate / --preflight-candidate write unique external files.
This source is unexecuted pending root and independent static review.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

REPO = Path(r"C:\Users\user\Documents\Codex\2026-09-29\simlox-c04-deadline\repo")
CASE = REPO / "cases/simlox-air-support/A17-var06-unit-group-xtime-v1.0.0"
RUN = CASE / "runs/a17-var06-xtime-v100-ssh-20261009-01"
ROOT_CUSTODY = REPO / "tmp/a17-var06-root-native-custody-v100-20261009/20261008T192137549330Z-75862c6d/receipt.json"
ROOT_CUSTODY_SHA = "c970a1dc21ab269018a04514a315cb81f7f3d0eb8f470d88560a68bf6103682d"
PREFLIGHT = CASE / "review/preflight-ssh0-20261008T191408484Z.json"
PREFLIGHT_SHA = "b0fdcc2bdd4cdc2c22f1e9170bb0b65eb4e735f975c44a0bdb15c91fa140c608"
NATIVE_PURE_SHA = "576d42676dfde1d5832b3e016dbe02aec9eb130726c20c1a83190e75c559c0fd"
PREFLIGHT_PURE_SHA = "0678cb5e401ff5b6a3f084d372c05c9b72c332d99e5f0633f8088d446c9c6685"
NATIVE_TRANSPORT = CASE / "transport-evidence/ssh-native-20261008T191956443157Z-9c7902f1"
NATIVE_TRANSPORT_SHA = "f70c8af7520fe2d1faf39d30e4a36c545de57d14f379dcba28f13cb671a710fe"
PREFLIGHT_TRANSPORT = CASE / "transport-evidence/ssh-preflight-20261008T191401241958Z-bfc3d6f2"
PREFLIGHT_TRANSPORT_SHA = "d42a4260e613e3e6fc440c893b53d85dea233877c9f3f12aa5e5abfcef73a63a"
OUTROOT = REPO / "tmp/a17-var06-author-postrun-candidates-v100-20261009"


def seal(path: Path) -> dict:
    assert path.is_file() and not path.is_symlink() and not path.is_junction(), str(path)
    body = path.read_bytes()
    return {"bytes": len(body), "sha256": hashlib.sha256(body).hexdigest()}


def pinned(path: Path, sha: str) -> dict:
    got = seal(path)
    assert got["sha256"] == sha, str(path)
    return json.loads(path.read_bytes())


def original(path: Path, role: str, expected: dict | None = None) -> dict:
    got = seal(path)
    stat = path.stat()
    assert stat.st_file_attributes & 1, str(path)
    if expected is not None:
        assert got == {key: expected[key] for key in ("bytes", "sha256")}
        assert stat.st_mode == expected["mode"] and stat.st_file_attributes == expected["attributes"]
    return {"role": role, "path": str(path), **got}


def pure_rows(proof_path: Path, proof_sha: str, label: str) -> list[dict]:
    proof = pinned(proof_path, proof_sha)
    assert proof["status"] == "passed" and proof["error"] is None
    assert proof["run_id"] == "a17-var06-xtime-v100-ssh-20261009-01"
    assert len(proof["checks"]) == 5
    rows = [original(proof_path, label + ":pure-proof")]
    expected_tools = ["build.py", "source_gate.py", "self_check.py",
                      "make_source_inventory.py", "make_prelaunch_manifest.py"]
    for tool, step in zip(expected_tools, proof["checks"], strict=True):
        assert step["tool"] == tool and step["status"] == "completed"
        assert type(step["exit_code"]) is int and step["exit_code"] == 0
        assert step["capture_error"] is None and step["error"] is None
        for stream in ("stdout", "stderr"):
            path = Path(step[stream + "_path"])
            assert path.parent == proof_path.parent
            row = original(path, label + ":" + tool + ":" + stream)
            assert {"bytes": row["bytes"], "sha256": row["sha256"]} == {
                "bytes": step[stream + "_bytes"], "sha256": step[stream + "_sha256"]}
            if stream == "stderr":
                assert row["bytes"] == 0
            rows.append(row)
    assert len(rows) == 11
    return rows


def transport_rows(directory: Path, receipt_sha: str, mode: str) -> list[dict]:
    receipt_path = directory / "transport-receipt.json"
    receipt = pinned(receipt_path, receipt_sha)
    assert receipt["mode"] == mode and type(receipt["exit_code"]) is int and receipt["exit_code"] == 0
    assert receipt["error"] is None and receipt["run_id"] == "a17-var06-xtime-v100-ssh-20261009-01"
    rows = [original(receipt_path, mode + ":transport-receipt")]
    for name in ("ssh-stdout.bin", "ssh-stderr.bin"):
        row = original(directory / name, mode + ":" + name)
        assert {"bytes": row["bytes"], "sha256": row["sha256"]} == receipt["streams"][name]
        rows.append(row)
    return rows


def raw_document() -> dict:
    custody = pinned(ROOT_CUSTODY, ROOT_CUSTODY_SHA)
    assert custody["source_roles"] == 193 and custody["source_bytes_modes_attributes_stable"] is True
    assert custody["original_run"] == str(RUN) and len(custody["originals"]) == 39
    assert len(custody["recovered"]) == 25
    invocation = pinned(RUN / "invocation.json", custody["originals"][str(RUN / "invocation.json")]["sha256"])
    pure_path = Path(invocation["pure_proof_path"])
    run_rows = []
    for path_text, expected in sorted(custody["originals"].items()):
        path = Path(path_text)
        if path.parent != RUN:
            continue
        row = original(path, "native_run_original", expected)
        recovered = Path(custody["recovered_run"]) / path.name
        assert seal(recovered) == {key: expected[key] for key in ("bytes", "sha256")}
        row["recovered_copy"] = str(recovered)
        run_rows.append(row)
    assert len(run_rows) == 25
    pure = pure_rows(pure_path, NATIVE_PURE_SHA, "native")
    transport = transport_rows(NATIVE_TRANSPORT, NATIVE_TRANSPORT_SHA, "native")
    rows = run_rows + pure + transport
    assert len(rows) == 39 and len({row["path"] for row in rows}) == 39
    assert {row["path"] for row in rows} == set(custody["originals"])
    return {"schema": "a17-var06-postrun-raw-custody-candidate/v100",
            "mandatory_original_count": 39, "native_run_original_count": 25,
            "native_pure_original_count": 11, "native_transport_original_count": 3,
            "recovered_run_copy_count": 25, "small_owned_raw_copy_count": 0,
            "root_custody": {"path": str(ROOT_CUSTODY), **seal(ROOT_CUSTODY)},
            "records": rows}


def preflight_document() -> dict:
    receipt = pinned(PREFLIGHT, PREFLIGHT_SHA)
    assert receipt["native_process_started"] is False and len(receipt["pure_checks"]) == 5
    pure_path = Path(receipt["pure_proof_path"])
    assert pure_path.parent == Path(receipt["pure_proof_directory"])
    assert seal(pure_path)["sha256"] == receipt["pure_proof_sha256"] == PREFLIGHT_PURE_SHA
    rows = [original(PREFLIGHT, "preflight:review-receipt")]
    rows += pure_rows(pure_path, PREFLIGHT_PURE_SHA, "preflight")
    rows += transport_rows(PREFLIGHT_TRANSPORT, PREFLIGHT_TRANSPORT_SHA, "preflight")
    assert len(rows) == 15 and len({row["path"] for row in rows}) == 15
    return {"schema": "a17-var06-postrun-preflight-custody-candidate/v100",
            "mandatory_original_count": 15, "native_process_started": False,
            "transport_self_captured": True, "outer_transport_capture_exists": False,
            "records": rows}


def main() -> None:
    parser = argparse.ArgumentParser()
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--raw-candidate", type=Path)
    group.add_argument("--preflight-candidate", type=Path)
    args = parser.parse_args()
    target = args.raw_candidate or args.preflight_candidate
    assert target.is_absolute() and target.parent == OUTROOT and not target.is_relative_to(CASE)
    document = raw_document() if args.raw_candidate else preflight_document()
    body = (json.dumps(document, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    with target.open("xb") as handle:
        handle.write(body)
    target.chmod(0o444)
    print(json.dumps({"schema": "a17-var06-custody-candidate-check/v100", "bytes": len(body),
                      "sha256": hashlib.sha256(body).hexdigest(), "records": len(document["records"]),
                      "native_calls": 0}, sort_keys=True))


if __name__ == "__main__":
    main()
