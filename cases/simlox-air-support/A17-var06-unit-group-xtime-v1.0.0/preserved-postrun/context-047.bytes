REPO = Path(r"C:\Users\user\Documents\Codex\2026-09-29\simlox-c04-deadline\repo")
CASE = REPO / "cases/simlox-air-support/A17-var06-unit-group-xtime-v1.0.0"
INDEX = CASE / "evidence-index.json"
INVENTORY = CASE / "source-inventory.json"
MANIFEST = CASE / "prelaunch-manifest.json"
CATALOG = REPO / "cases/simlox-air-support/publication-index-v1.json"
RUN = CASE / "runs/a17-var06-xtime-v100-ssh-20261009-01"
ROOT_CUSTODY = REPO / "tmp/a17-var06-root-native-custody-v100-20261009/20261008T192137549330Z-75862c6d/receipt.json"
INVENTORY_PIN = (8557, "6b81de61")  # final full SHA to bind before publication
MANIFEST_PIN = (72081, "667f1ca7")  # final full SHA to bind before publication
ROOT_CUSTODY_PIN = (19446, "c970a1dc21ab269018a04514a315cb81f7f3d0eb8f470d88560a68bf6103682d")
GO_PIN = None  # independent receipt-bound GO pending
SCOPE_PIN = None  # independent bounded signoff pending
