"""Root original-byte capture of one explicitly pinned E02 method invocation."""
from pathlib import Path
import datetime as dt
import hashlib
import json
import stat
import subprocess
import sys
import uuid

R = Path(__file__).resolve().parents[1]
C = R / 'cases/simlox-air-support/E02-var02-repair-return-after-deadline-v1.0.4'

def pin(path):
    data = path.read_bytes()
    return {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}

assert len(sys.argv) == 3
spec_path = Path(sys.argv[1]).resolve(strict=True)
assert spec_path.is_relative_to(R / 'tmp')
assert spec_path.stat().st_file_attributes & 1
assert pin(spec_path)['sha256'] == sys.argv[2]
spec = json.loads(spec_path.read_bytes())
assert set(spec) == {'schema', 'label', 'method', 'method_pin', 'arguments', 'native_dispatch'}
assert spec['schema'] == 'e02-var02-root-command-spec/v104'
assert type(spec['native_dispatch']) is bool
label = spec['label']
assert type(label) is str and label and all(c.isalnum() or c == '-' for c in label)
method = Path(spec['method']).resolve(strict=True)
assert method.is_relative_to(R / 'tmp') or method.is_relative_to(C)
assert method.suffix in ('.py', '.ps1') and method.stat().st_file_attributes & 1
assert not method.stat().st_file_attributes & 1024
assert pin(method) == spec['method_pin']
assert type(spec['arguments']) is list and all(type(x) is str for x in spec['arguments'])
if spec['native_dispatch']:
    assert method == C / 'ssh_transport.py' and spec['arguments'] == ['native']
else:
    assert method != C / 'run_native_ssh.ps1'
    assert method != C / 'ssh_transport.py' or spec['arguments'] == ['preflight']
assert Path(__file__).stat().st_file_attributes & 1
before = {'capture': pin(Path(__file__)), 'spec': pin(spec_path), 'method': pin(method)}
argv = ([sys.executable, '-X', 'utf8', '-B', str(method)] if method.suffix == '.py'
        else [r'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe',
              '-NoLogo', '-NoProfile', '-NonInteractive', '-File', str(method)]) + spec['arguments']
outdir = R / 'tmp/e02-var02-root-command-proofs-v104-20261009' / (
    label + '-' + dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ') + '-' + uuid.uuid4().hex[:8])
outdir.mkdir(parents=True, exist_ok=False)
started = dt.datetime.now(dt.timezone.utc).isoformat()
with (outdir / 'stdout.bin').open('xb') as stdout, (outdir / 'stderr.bin').open('xb') as stderr:
    code = subprocess.run(argv, cwd=R, stdout=stdout, stderr=stderr).returncode
after = {'capture': pin(Path(__file__)), 'spec': pin(spec_path), 'method': pin(method)}
receipt = {'schema': 'e02-var02-root-command-proof/v104', 'argv': argv,
           'started_utc': started, 'completed_utc': dt.datetime.now(dt.timezone.utc).isoformat(),
           'native_dispatch': spec['native_dispatch'], 'actual_exit': code,
           'method_before': before, 'method_after': after,
           'streams': {name: pin(outdir / name) for name in ('stdout.bin', 'stderr.bin')}}
with (outdir / 'receipt.json').open('xb') as stream:
    stream.write((json.dumps(receipt, indent=2) + '\n').encode())
for path in outdir.iterdir():
    path.chmod(stat.S_IREAD)
print(json.dumps({'receipt': str(outdir / 'receipt.json'), **pin(outdir / 'receipt.json'),
                  'actual_exit': code, 'method_unchanged': before == after,
                  'native_dispatch': spec['native_dispatch'], 'streams': receipt['streams']}))
for name in ('stdout.bin', 'stderr.bin'):
    body = (outdir / name).read_bytes()
    if body:
        print(body.decode('utf-8-sig', 'replace')[:12000])
assert before == after
raise SystemExit(code)
