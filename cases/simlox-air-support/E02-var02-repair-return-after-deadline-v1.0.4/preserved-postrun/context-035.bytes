"""Root fresh frozen-byte and absent-path custody; no behavior or native calls."""
from pathlib import Path
import datetime as dt, hashlib, json, sys
R=Path(__file__).resolve().parents[1]
C=R/'cases/simlox-air-support/E02-var02-repair-return-after-deadline-v1.0.4'
F=R/'tmp/e02-var02-root-static-freeze-v104-20261009.json'
N=R/'tmp/e02-var02-native-v104-20261009-01'
def pin(p):
    b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def plain(p):
    for q in (p,*p.parents):
        if q.exists():assert not q.is_symlink() and not q.is_junction() and not q.stat().st_file_attributes&1024,str(q)
assert len(sys.argv)==4 and sys.argv[1] in ('preflight','native')
phase=sys.argv[1];go=Path(sys.argv[2]).resolve(strict=True)
plain(go);assert go.is_relative_to(R) and go.stat().st_file_attributes&1 and pin(go)['sha256']==sys.argv[3]
plain(F);assert F.stat().st_file_attributes&1 and pin(F)['sha256']=='321bcf8ea42a0bde82e74bd2588c4591533d83830bc36b5bfc58d3f427fb4f5b'
f=json.loads(F.read_bytes())
assert f['schema']=='e02-var02-root-static-freeze/v104' and f['native_dispatch'] is False
assert len(f['case_sources'])==44 and len(f['mandatory_originals'])==42
for rel,value in f['case_sources'].items():
    p=C/rel;plain(p);assert pin(p)==value and p.stat().st_file_attributes&1
for row in f['mandatory_originals']:
    p=Path(row['path']);plain(p);s=p.stat()
    assert pin(p)=={k:row[k] for k in ('bytes','sha256')}
    assert s.st_mode==row['original_mode'] and s.st_file_attributes==row['original_attributes']
m=json.loads((C/'prelaunch-manifest.json').read_bytes())
assert m['schema']=='e02-var02-prelaunch-manifest/v104' and m['source_count']==274 and len(m['source_files'])==274
for row in m['source_files']:
    p=Path(row['path']);plain(p);assert pin(p)=={k:row[k] for k in ('bytes','sha256')}
    if row['key'].startswith(('excluded-source:','excluded-failed-original:','excluded-diagnostic-copy:')) or row['key'] in ('excluded-source-inventory','excluded-prelaunch-manifest','excluded-failure-custody'):
        assert p.stat().st_file_attributes&1
plain(N);assert not N.exists() and not (C/'runs').exists()
if phase=='preflight':assert not (C/'transport-evidence').exists() and not (C/'test-output').exists() and not (C/'review/independent-prelaunch-go.json').exists()
else:assert go==C/'review/independent-prelaunch-go.json'
print(json.dumps({'schema':'e02-var02-root-fresh-custody/v104','utc':dt.datetime.now(dt.timezone.utc).isoformat(),'phase':phase,'source_roles':274,'frozen_files':44,'mandatory_originals':42,'native_run_absent':True,'independent_gate':{'path':str(go),**pin(go)},'native_calls':0,'accepted_checker_calls':0,'decision':'PASS_CUSTODY_ONLY'}))
