  "source_design": {
    "parent": "Byte-exact accepted A16 native-input.json; preserve every model/table/instance/column/row not listed, including Control seed1/horizon36, station, ItemStructure A/B additions, StockAllocation one A and one B local spare, and repair rules.",
    "common_patch": [
      {
        "table": "ProblemDescription",
        "operation": "replace sole PDESC with arm-specific description"
      },
      {
        "table": "SystemDeployment",
        "key": [
          "TEACH-AIR-01",
          "TEACH-UNIT"
        ],
        "column": "QTYPS",
        "before": 1,
        "after": 2
      },
      {
        "table": "MissionType",
        "operation": "replace three rows by one SHARED-CONFIG-MISSION row derived from CONF-A-MISSION; set NOS=MNOS=2 and retain DURN=2 and other timing/reliability cells"
      },
      {
        "table": "OperationProfile",
        "operation": "replace three rows by one BASIC-SCHEDULE/SHARED-CONFIG-MISSION row at STIM8, SCHEDULED, IQTY1, DTIM=1/3; retain other cells"
      },
      {
        "table": "MissionSystem",
        "operation": "replace three rows by two seven-column SHARED-CONFIG-MISSION rows: TEACH-CONF-A PRI1 NOS1 MNOS1 and TEACH-CONF-B PRI2 NOS1 MNOS1; MNOSA null"
      },
      {
        "table": "Resource",
        "operation": "add accepted C05.var02 SPECIAL rows MISSION-CREW and MISSION-RADIO"
      },
      {
        "table": "ResourceAllocation",
        "operation": "add AIR_BASIC/BASE-01 MISSION-CREW RQTY2 and MISSION-RADIO RQTY0"
      },
      {
        "table": "MissionResource",
        "operation": "add accepted C05 five-column MTID,SID,RID,QTY,NOTE schema; A requires crew1 and B requirement varies by arm"
      }
    ],
    "unchanged_critical": [
      "System TEACH-CONF-A/B CBSID=TEACH-AIR-01; never substitute BSID",
      "ItemStructure base LRU and one A/B additive LRU",
      "StockAllocation BASE-01 one A and one B opening spare",
      "SystemRepair, Control, ResultCollection and policy/transport unchanged"
    ],
    "pair_isolation": {
      "crew_B": [
        "SHARED-CONFIG-MISSION",
        "TEACH-CONF-B",
        "MISSION-CREW",
        1,
        null
      ],
      "radio_B": [
        "SHARED-CONFIG-MISSION",
        "TEACH-CONF-B",
        "MISSION-RADIO",
        1,
        null
      ],
      "permitted_pair_changes": [
        "ProblemDescription.PDESC",
        "MissionResource B row RID as key deletion/addition"
      ],
      "all_else": "structurally and value-identical"
    },
    "expected_counts": {
      "parent_tables": 32,
      "child_tables": 33,
      "parent_row_containing": 21,
      "child_row_containing": 24
    },
    "forbidden_changes": [
      "BSID proxy",
      "different MTIDs for A and B",
      "one-hour duration change",
      "stock/reliability changes",
      "arm-specific ResourceAllocation"
    ]
  },
  "predeclared_native_gate": {
    "converter": "Both arms must report Errors: 0, Warnings: 4, Notes: 0, with exactly one #108 and three item-attributed #2053 (TEACH-LRU-01/A/B), matching the accepted A16 zero-FRT item set; any other diagnostic is frozen-contract NO_GO.",
    "roundtrip": "Exact 24 row-containing authored tables including metadata, keys, datatype, instance_name and all rows; no non-null native placeholder drift elsewhere.",
    "guard": "Unique absent run dirs, unchanged source before/after, SSH session0/sshd, Global\\SimloxIssue18NativeQueue mutex, exact existing GUI PID13340/session1/start1790590196826 responding before/after; explicitly decode every PowerShell JSON/log read as UTF-8 under Windows PowerShell 5; no GUI control, process termination or retry; preserve closure on failure.",
    "crew_arm": "One physical TEACH-CONF-A and one TEACH-CONF-B allocated to same SHARED-CONFIG-MISSION; each gets crew1, neither gets radio; launch h8, success/completion h10, release both crews on logged return; no cancel or backorder.",
    "radio_arm": "In the same SHARED-CONFIG-MISSION allocation attempt, native event context must show a MISSION-RADIO request for one unit against zero capacity, no radio grant/booking, and no two-system launch/success. The resource test may print a base-SID candidate before reconfiguration; attribute the B requirement only through frozen MissionSystem and MissionResource rows plus ordered mission/candidate identity and event context, never by requiring a literal TEACH-CONF-B tag on the failed test. A may be partly booked; all such crew bookings must be released by logged cancellation. Do not assume atomic formation allocation or a fixed cancellation timestamp.",
    "stock": "Trace every opening and subsequent A/B LRU item ID and each observed stock-take, configuration-fit, removal and stock-return event edge independently. Reconcile physical stock by item TYPE and count, opening-to-terminal balances and any backorder; do not require the same literal serial ID on removal/return as was taken for fit because accepted A16 logs assign new IDs. Report every observed ID and leave unlogged serial continuity unverified. Do not assume arm parity after shortage.",
    "resource": "Derive used/waiting spans for each RID from grants/releases/requests, reconcile 72 bins and total means; do not assume a child crew hold duration.",
    "report": "Exactly six default tables and 5210 cells per arm: ProblemDescription 1x1, ResultSummary 1x11, SystemResults 72x40, StockTotalResults 72x16, ResourceResults 72x16, ResourceResultsTotal 1x14. Reconcile every cell to native events, nulls, time fractions, mission/stock/resource ledgers and terminal state; handle native float precision explicitly.",
    "horizon": "36h at half-hour collection; distinguish h35.5–36 last bin from h36 terminal event.",
    "failure_policy": "Any source, roundtrip, converter, identity, physical or full-report mismatch is diagnostic NO_GO under this frozen contract; preserve sealed failure, revise only in a new version before further native work."
  },
  "limitations": [
    "One fixed seed/unit, two CBSID additive configurations, one two-hour shared mission and one resource contrast; catalog one-hour form untested.",
    "A16, A11 and C05 separately establish components, not this combined outcome.",
    "Partial A allocation is allowed in negative arm; no atomic formation claim.",
    "No general inheritance, other seeds, GUI rendering, remote resources or cross-engine parity.",
    "Accepted A16 may relabel an item on removal; serial continuity across fit/return is unverified.",
    "A radio availability test may print the base SID before configuration; B association is source/candidate-bound, not a literal test-line CBSID claim."
  ],
