"""Read-only, source-independent diagnosis of the excluded I05 v102 export.

This is a diagnostic, not a roundtrip acceptance checker. It invokes no native
software, accepted checker, author module, Git command, or network service.
"""
from __future__ import annotations

import hashlib
import json
import math
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PARENT = REPO / "cases/simlox-air-support/E05-local-repair-reissue-v1.0.0"
COPY = REPO / "tmp/i05-var04-failed-native-custody-v102-20261009-01"
ROOT_PROOF = REPO / "tmp/i04-var09-root-review-proofs-v100-20261008/i05-var04-v102-failed-native-custody-20261009T022921549377Z-ff0bc236/receipt.json"
NATIVE_PROOF = REPO / "tmp/i05-var04-root-command-proofs-v102-20261009/ssh-native-v102-20261009T022438509735Z-f49fd91d/receipt.json"
PIN = {
    "custody": (22702, "92bf4a4e16940f1d1d2ee733351a0ce9a85e49a06284bdd6994b7f6f9a77c61e"),
    "root_proof": (1361, "b5551a275cf4f49bd2c481050f92b7520b85febc961d618b572347cd199456d8"),
    "native_proof": (1622, "539f612df9763ca6598abc3471d1b32ff8d81c4842961763002b603076e0eb6e"),
    "parent_input": (43690, "ee294a430382811a1e0f1d058fbca4fd1df6f7f0646300c671ccc1bcbe0055ca"),
    "parent_export": (57986, "896387a14791dd6f14ceec9acf6398beca981656fc0656019e7849df2af79b21"),
    "child_input": (45095, "f4157f818f9f7c00a18b01074fcde9d52ed81baa8f4d92d8e3c323f2bf2545c2"),
    "child_export": (59600, "ceb4c40d7d43cf1ed55be49004a8131b77871b61ea747b5b4aae49975731099e"),
}


def sealed(path: Path, pin: tuple[int, str]) -> bytes:
    assert path.is_file() and not path.is_symlink() and not path.is_junction(), path
    raw = path.read_bytes()
    assert (len(raw), hashlib.sha256(raw).hexdigest()) == pin, path
    return raw


def parsed(raw: bytes) -> object:
    assert not raw.startswith(b"\xef\xbb\xbf")
    def pairs(seq: list[tuple[str, object]]) -> dict[str, object]:
        out: dict[str, object] = {}
        for k, v in seq:
            assert k not in out, ("duplicate JSON key", k)
            out[k] = v
        return out
    def bad_const(token: str) -> object:
        raise AssertionError(("nonfinite JSON", token))
    return json.loads(raw.decode("utf-8"), object_pairs_hook=pairs, parse_constant=bad_const)


def same(a: object, b: object, datatype: str | None = None) -> bool:
    if a is None or b is None:
        return a is b is None
    if datatype == "double":
        return type(a) in (int, float) and type(b) in (int, float) and math.isfinite(a) and math.isfinite(b) and a == b
    if datatype == "integer":
        return type(a) is type(b) is int and a == b
    if datatype == "string":
        return type(a) is type(b) is str and a == b
    if type(a) is not type(b):
        return False
    if type(a) is dict:
        return set(a) == set(b) and all(same(a[k], b[k]) for k in a)
    if type(a) is list:
        return len(a) == len(b) and all(same(x, y) for x, y in zip(a, b, strict=True))
    return a == b


def cells_equal(expected: object, actual: object) -> int:
    assert type(expected) is type(actual) is dict
    assert set(expected) == set(actual) == {"name", "columns", "instances"}
    assert same(expected["name"], actual["name"])
    ec, ac = expected["columns"], actual["columns"]
    assert type(ec) is type(ac) is list and len(ec) == len(ac)
    for x, y in zip(ec, ac, strict=True):
        assert type(x) is type(y) is dict and set(x) == set(y)
        assert set(x) in ({"name", "datatype"}, {"name", "datatype", "key"})
        assert same(x, y), (expected["name"], "column metadata", x, y)
    ei, ai = expected["instances"], actual["instances"]
    assert type(ei) is type(ai) is list and len(ei) == len(ai)
    count = 0
    for x, y in zip(ei, ai, strict=True):
        assert type(x) is type(y) is dict and set(x) == set(y) == {"instance_name", "rows"}
        assert same(x["instance_name"], y["instance_name"])
        xr, yr = x["rows"], y["rows"]
        assert type(xr) is type(yr) is list and len(xr) == len(yr)
        for row_x, row_y in zip(xr, yr, strict=True):
            assert type(row_x) is type(row_y) is list and len(row_x) == len(row_y) == len(ec)
            for c, vx, vy in zip(ec, row_x, row_y, strict=True):
                assert same(vx, vy, c["datatype"]), (expected["name"], c["name"], vx, vy)
                count += 1
    return count


def table_map(doc: object) -> tuple[list[str], dict[str, object], object]:
    assert type(doc) is dict and set(doc) == {"model"}
    body = doc["model"]
    assert type(body) is dict and set(body) == {"database_version", "tables"}
    tables = body["tables"]
    assert type(tables) is list and all(type(t) is dict and type(t.get("name")) is str for t in tables)
    names = [t["name"] for t in tables]
    assert len(names) == len(set(names))
    return names, {t["name"]: t for t in tables}, body["database_version"]


def main() -> None:
    custody = parsed(sealed(COPY / "receipt.json", PIN["custody"]))
    root_proof = parsed(sealed(ROOT_PROOF, PIN["root_proof"]))
    native_proof = parsed(sealed(NATIVE_PROOF, PIN["native_proof"]))
    assert custody["decision"] == "NO_GO_PRESERVED" and custody["semantic_acceptance"] is False
    assert custody["failure_stage"] == "check_import_export" and custody["source_bytes_modes_attributes_stable"] is True
    assert custody["frozen_case_file_count"] == 59 and custody["source_role_count"] == 274
    assert len(custody["copies"]) == 15 and len(custody["originals_after_freeze"]) == 29
    assert type(root_proof) is dict and type(native_proof) is dict
    for name, seal in custody["copies"].items():
        assert name == Path(name).name
        raw = sealed(COPY / "raw" / name, (seal["bytes"], seal["sha256"]))
        assert len(raw) == seal["bytes"]
        assert (COPY / "raw" / name).stat().st_file_attributes & 1
    pinput = parsed(sealed(PARENT / "native-input.json", PIN["parent_input"]))
    pexport = parsed(sealed(PARENT / "runs/e05-v100-ssh-20260929-01/roundtrip-raw.json", PIN["parent_export"]))
    cinput = parsed(sealed(COPY / "raw/input.json", PIN["child_input"]))
    cexport = parsed(sealed(COPY / "raw/roundtrip-raw.json", PIN["child_export"]))
    pi, pim, pver = table_map(pinput)
    pe, pem, ever = table_map(pexport)
    ci, cim, cver = table_map(cinput)
    ce, cem, cever = table_map(cexport)
    new = "ChangesItemRepair"
    assert len(pi) == len(pe) == 31 and len(ci) == len(ce) == 32
    assert new not in pi and new not in pe and ci.count(new) == ce.count(new) == 1
    assert ci.index(new) == 12 and ce.index(new) == 17
    assert [n for n in ci if n != new] == pi
    assert [n for n in ce if n != new] == pe
    assert same(pver, cver) and same(ever, cever)
    authored_parent_cells = sum(cells_equal(pim[n], cim[n]) for n in pi)
    export_parent_cells = sum(cells_equal(pem[n], cem[n]) for n in pe)
    new_cells = cells_equal(cim[new], cem[new])
    assert authored_parent_cells == 274 and export_parent_cells == 369 and new_cells == 10
    assert cim[new]["instances"] == [{"instance_name": "", "rows": [["TEACH-LRU-01", "BASE-01", 5, 1.5, 0, 1, 1, None, None, None]]}]
    print(json.dumps({
        "schema": "i05-var04-independent-excluded-export-diagnostic/v100",
        "decision": "NO_GO_DIAGNOSTIC_ONLY",
        "failed_run_accepted": False,
        "custody_originals": 29,
        "readonly_diagnostic_copies": 15,
        "parent_table_count": 31,
        "child_table_count": 32,
        "authored_new_table_index": 12,
        "native_export_new_table_index": 17,
        "unchanged_authored_cells_by_identity": authored_parent_cells,
        "unchanged_export_cells_by_identity": export_parent_cells,
        "new_export_cells": new_cells,
        "all_export_cells": export_parent_cells + new_cells,
        "native_calls": 0,
        "accepted_checker_calls": 0,
    }, sort_keys=True))


if __name__ == "__main__":
    main()
