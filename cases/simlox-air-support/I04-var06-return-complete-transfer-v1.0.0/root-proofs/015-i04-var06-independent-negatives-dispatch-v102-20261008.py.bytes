"""Pinned no-argument read-only dispatch for meaningful below-SHA negatives."""
from pathlib import Path
import hashlib
import runpy
import sys

REPO=Path(r"C:\Users\user\Documents\Codex\2026-09-29\simlox-c04-deadline\repo")
REVIEW=REPO/"cases/simlox-air-support/I04-var06-return-complete-transfer-v1.0.0/review"
PINS={
 "independent_classifier.py":"ba4175c287b2ae1adf8dc6a24802205286df05df520a1d84298a1ca36ab90dcd",
 "independent_self_check_v102.py":"ec6636508ae2ab32a601205d33698195fee576cd6433c974c978f51309584fc2",
}
def check():
    for name,pin in PINS.items():
        path=REVIEW/name
        assert hashlib.sha256(path.read_bytes()).hexdigest()==pin
        assert path.stat().st_file_attributes & 1

check()
sys.path.insert(0,str(REVIEW))
runpy.run_path(str(REVIEW/"independent_self_check_v102.py"),run_name="__main__")
check()