def pin(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def checked(row):
 p=Path(row['original_path']);b=p.read_bytes()
 assert pin(b)=={k:row[k] for k in ('bytes','sha256')},str(p)
 assert not p.stat().st_mode&stat.S_IWRITE,str(p)
 return p,b,p.stat().st_mode,p.stat().st_file_attributes
sources=[checked(row) for row in ROWS]
assert C.is_dir() and not O.exists()
O.mkdir(exist_ok=False)
records=[]
for row,(p,b,mode,attributes) in zip(ROWS,sources):
 target=C/row['owned_path'];assert target.parent==O
 with target.open('xb') as f:f.write(b)
 target.chmod(stat.S_IREAD)
 assert target.read_bytes()==b and not target.stat().st_mode&stat.S_IWRITE
 assert p.read_bytes()==b and p.stat().st_mode==mode and p.stat().st_file_attributes==attributes
 records.append({**row,'original_mandatory':True,'original_attributes':attributes,'copy_readonly':True})
self_path=Path(__file__).resolve();self_bytes=self_path.read_bytes()
assert not self_path.stat().st_mode&stat.S_IWRITE
target=O/'053-root-copy-method.py.bytes'
with target.open('xb') as f:f.write(self_bytes)
target.chmod(stat.S_IREAD)
records.append({'original_path':str(self_path),'owned_path':target.relative_to(C).as_posix(),**pin(self_bytes),'original_mandatory':True,'original_attributes':self_path.stat().st_file_attributes,'copy_readonly':True})
for row,(p,b,mode,attributes) in zip(ROWS,sources):
 assert p.read_bytes()==b and p.stat().st_mode==mode and p.stat().st_file_attributes==attributes
assert target.read_bytes()==self_bytes
record={'schema':'i04-var06-root-small-proof-custody/v100','utc':dt.datetime.now(dt.timezone.utc).isoformat(),'decision':'PASS_SMALL_PROOF_COPIES_ONLY','copies':records,'copies_count':54,'native_calls':0,'accepted_checker_calls':0,'semantic_execution':False,'private_app_snapshot_copied':False,'native_raw_copied':False,'full_manual_copied':False}
manifest=O/'custody-manifest.json'
with manifest.open('xb') as f:f.write((json.dumps(record,indent=2)+'\n').encode())
manifest.chmod(stat.S_IREAD)
assert len(list(O.iterdir()))==55
print(json.dumps({'decision':record['decision'],'manifest':str(manifest),**pin(manifest.read_bytes()),'copies':54,'native_calls':0}))
