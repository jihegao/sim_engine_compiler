    },
    "derived_quantity_ledger": {
        "opening_local": 2,
        "before_h6": {"local_total": 2, "started_unarrived_OUT_task_quantity": 0, "completed_OUT_task_quantity": 0},
        "h6_to_terminal_h36": {"local_total": 1, "started_unarrived_OUT_task_quantity": 1, "completed_OUT_task_quantity": 0},
        "conservation": "For this one typed OUT task only, opening2 = current local physical P-CREW1 + departed task quantity still unarrived1 + completed OUT task quantity0. Local free+booked+using=local physical1, subject to exact booking/usage intervals. Nominal local quantity decrements once at h6 and stays1. This is derived task-quantity accounting, not observed persistent outside-person or outside-pool state.",
        "terminal": "At h36 source horizon, exactly one started OUT task with quantity1 has no linked arrival/cancellation; locally free1, booked0, using0, nominal1, derived unarrived1, completed OUT0. Any unexplained token or shifted edge is NO_GO.",
