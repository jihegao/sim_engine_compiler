payload = (json.dumps(contract, ensure_ascii=False, sort_keys=True, indent=2) + "\n").encode("utf-8")
with OUT.open("xb") as stream:
    stream.write(payload)
print(json.dumps({"contract": str(OUT), **pin(payload), "source_refs": len(source_refs),
                  "raw_records": len(raw_records), "package_absent": not PACKAGE.exists()}, sort_keys=True))
