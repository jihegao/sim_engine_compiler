        "OperationProfile_DTIM_hours_each": 1.0,
        "MissionType": {"MTID": "BASIC-MISSION", "NOS": 2, "MNOS": 2, "DURN_hours": 1.0, "TFOUT_fraction": 0.25, "TFRET_fraction": 0.25},
        "mission_fraction_to_hours_for_this_DURN": {"outbound": 0.25, "return": 0.25},
        "preparation_subtask_hours_each": 0.5,
        "crew_demand_per_preparation_subtask": 1,
