          "version": null,
          "status": "planned",
          "planned_delta": "仅普通补货"
        },
        {
          "variant_id": "E09.var06",
          "version": null,
          "status": "planned",
          "planned_delta": "与横向组独立/组合"
        }
      ],
      "method_ids": [
