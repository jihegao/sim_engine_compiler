      "artifact_ref": null,
      "title_zh": "专用保障路线与 FAST/SLOW 订货",
      "core_case": false,
      "instructional_prerequisites": [
        "E04"
      ],
      "planned_delta": "为物项或系统覆盖一般保障路线",
      "minimal_configuration": "基层与两个保障站；一件可修件，分别使用一般路线、物项专用和系统远程修理路线",
      "acceptance_plan": [
        "核对专用记录整体覆盖一般记录，遗漏字段不得误继承；检查所有上下行实物和需求",
        "相同正运输时长下比较 FAST 立即传需求和 SLOW 等故障件到达",
        "多上级路线验证 DFRAC 概率和为一，需求与对应故障件始终同路"
      ],
      "boundary_variants": [
