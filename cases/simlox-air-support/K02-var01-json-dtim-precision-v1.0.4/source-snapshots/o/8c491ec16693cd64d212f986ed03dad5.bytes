    {
      "case_id": "E15",
      "title": "按库存点及固定周期订货",
      "version": null,
      "parent_case": "E02",
      "delta": "分别验收两种外购补充策略",
      "requires": [
        "E02"
      ],
      "status": "planned",
      "verified_features": [],
      "cross_engine_status": "unverified",
      "artifact_ref": null,
      "title_zh": "按库存点及固定周期订货",
      "core_case": false,
      "instructional_prerequisites": [
        "E02"
      ],
      "planned_delta": "分别验收两种外购补充策略",
      "minimal_configuration": "一个可弃件订货位置，STSIZ=4、ROSIZ=2、交货期1小时；独立变体用ROINT>0。另分别设置AINST=2且不填ISTOH，以及显式ISTOH，区分名义库存、额外初始量与初始实物。",
      "acceptance_plan": [
        "库存策略核对在手+在订+调拨量形成的库存状态、STSIZ-ROSIZ订货点、固定批量和到货时间；ROSIZ≤STSIZ+1",
        "周期策略核对指定时刻的变动补货量、ROSIZ忽略警告及欠交先满足；保留多笔未到订单账",
        "ISTOH缺省为STSIZ+AINST，显式值只改变初始阶段；库存策略ISTOH≥STSIZ-ROSIZ，周期策略ISTOH≥STSIZ，不满足时必须保留错误证据"
      ],
      "boundary_variants": [
        {
          "variant_id": "E15.var01",
          "version": null,
          "status": "planned",
          "planned_delta": "ROINT=0/正值"
        },
        {
          "variant_id": "E15.var02",
          "version": null,
          "status": "planned",
          "planned_delta": "零/非零交货期"
        },
        {
          "variant_id": "E15.var03",
          "version": null,
          "status": "planned",
          "planned_delta": "多个在订批次"
        },
        {
          "variant_id": "E15.var04",
          "version": null,
          "status": "planned",
          "planned_delta": "随机LEADTD"
        },
        {
          "variant_id": "E15.var05",
          "version": null,
          "status": "planned",
          "planned_delta": "期末未到货"
        },
        {
          "variant_id": "E15.var06",
          "version": null,
          "status": "planned",
          "planned_delta": "AINST=0/正值"
        },
        {
          "variant_id": "E15.var07",
          "version": null,
          "status": "planned",
          "planned_delta": "ISTOH缺省/显式且高于名义"
        },
        {
          "variant_id": "E15.var08",
          "version": null,
          "status": "planned",
          "planned_delta": "库存策略ISTOH等于/低于订货点"
        },
        {
          "variant_id": "E15.var09",
          "version": null,
          "status": "planned",
          "planned_delta": "周期策略ISTOH等于/低于STSIZ"
        },
        {
          "variant_id": "E15.var10",
          "version": null,
          "status": "planned",
          "planned_delta": "ROSIZ超过STSIZ+1负例"
        }
      ],
      "method_ids": [
        "M-E15"
      ],
      "limitations": [
        "只用于DU/PRU/DP/SPRU；计划参数变更不能切换这两类策略",
        "AINST/ISTOH仅适用于订货位置；初始实物可高于STSIZ，不能从名义水平直接推断在手量"
      ],
      "case_kind": "modeling_method",
      "publication_state": "not_published",
      "capability_state": "manual_documented_native_verification_required",
      "reproduce_command": null,
      "reproduction_guide": null
    },
