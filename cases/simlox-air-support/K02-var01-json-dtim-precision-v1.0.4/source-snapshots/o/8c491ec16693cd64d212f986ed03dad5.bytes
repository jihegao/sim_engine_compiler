      "status": "planned",
      "verified_features": [],
      "cross_engine_status": "unverified",
      "artifact_ref": null,
      "title_zh": "飞机计划加入、退出与转场部署",
      "core_case": false,
      "instructional_prerequisites": [
        "A02",
        "A17",
        "D03",
        "D09"
      ],
      "planned_delta": "按时间表改变运行单位的飞机部署",
      "minimal_configuration": "两基地、一种机型、一架机先执行任务，再按指定时刻计划转场；变体独立加入第二架机",
      "acceptance_plan": [
        "核对源单位、等待可迁移、离开、在途及抵达后可执行任务的时间线",
        "只从 ready pool 迁出；维护或返航保障后就绪时先处理待迁移，再分配新任务",
        "非关键故障或非关键 PM 飞机仍可迁移；迁入飞机进入 ready pool 后再参与其他迁移或任务",
        "记录稳定飞机身份、PM 计数与未完成状态是否随转场保留，缺乏可见证据者列限制",
        "核对 IN/OUT 总数变化、任务占用导致的分批迁移及两地不能重复分配同一飞机"
      ],
