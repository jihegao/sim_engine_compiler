          "variant_id": "E09.var02",
          "version": null,
          "status": "planned",
          "planned_delta": "ENBOP=Y 且 BOPRI=Y：紧急需求优先"
        },
        {
          "variant_id": "E09.var03",
          "version": null,
          "status": "planned",
          "planned_delta": "ENBOP=N 且 BOPRI=Y：优先设置被忽略"
