      ],
      "planned_delta": "让上级按基层实际欠交调整服务顺序",
      "minimal_configuration": "两个基层向同一上级等待一件到货；显式设 Control.ENBOP=Y；较早普通补货与较晚紧急欠交形成竞争；另设 ENBOP=N 对照",
      "acceptance_plan": [
        "在 Control.ENBOP=Y 时仅切换 Station.BOPRI，比较到货分配目的地和剩余队列",
        "在 Control.ENBOP=N 时保留 BOPRI=Y，验证站点优先设置不生效",
        "核对实物只分配一次，等待与欠交数量随分配同步结算"
      ],
      "boundary_variants": [
        {
          "variant_id": "E09.var01",
          "version": null,
          "status": "planned",
          "planned_delta": "ENBOP=Y 且 BOPRI=N：FIFO"
