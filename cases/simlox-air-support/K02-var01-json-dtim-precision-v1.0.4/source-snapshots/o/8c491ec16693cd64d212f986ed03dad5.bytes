          "version": null,
          "status": "planned",
          "planned_delta": "不同上下行时长"
        },
        {
          "variant_id": "E07.var06",
          "version": null,
          "status": "planned",
          "planned_delta": "断开子树/非法循环"
        },
        {
          "variant_id": "E07.var07",
          "version": null,
