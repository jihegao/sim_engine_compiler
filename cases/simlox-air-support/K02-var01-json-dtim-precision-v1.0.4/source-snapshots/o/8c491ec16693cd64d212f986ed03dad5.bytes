    {
      "case_id": "B03",
      "title": "cold-start first-wave and hot-sortie preparation by explicit mission type",
      "version": null,
      "parent_case": "B02",
      "delta": "explicit mission types select different preparation contracts",
      "requires": [
        "B02",
        "A02"
      ],
      "status": "planned",
      "verified_features": [],
      "cross_engine_status": "unverified",
      "artifact_ref": null,
      "original_parent_case": "B02",
      "original_requires": [
        "B02"
      ],
      "title_zh": "显式任务类型的冷启动首波与热出动保障差异",
      "core_case": true,
      "instructional_prerequisites": [
        "B02",
        "A02"
      ],
      "planned_delta": "以显式任务类型分别表达首波冷启动出动和后续热出动，并验证两套保障合同",
      "minimal_configuration": "同一架飞机连续执行三次非重叠出动；第一次绑定冷启动首波任务类型 COLD-FIRST，后两次绑定热出动任务类型 HOT-SORTIE；两种任务类型分别关联可辨识的准备工序，其他机制关闭",
      "acceptance_plan": [
        "按 explicit-mission-type-v1 合同建立 COLD-FIRST 与 HOT-SORTIE，逐字段核对 MissionType、MissionPreparation 和 TaskBreakDown 的绑定及原生回导",
        "逐次核对任务类型身份、准备工序、开始完成时刻和资源账；首波只能执行冷启动合同，后两波只能执行热出动合同",
        "同一任务类型是否能按历史出动序号自动切换保障另作能力探针；未确认或不支持不阻断 explicit-mission-type-v1 的验收"
      ],
      "boundary_variants": [
        {
          "variant_id": "B03.var01",
          "version": null,
          "status": "planned",
          "planned_delta": "COLD-FIRST 首波冷启动工序"
        },
        {
          "variant_id": "B03.var02",
          "version": null,
          "status": "planned",
          "planned_delta": "HOT-SORTIE 后续热出动工序"
        },
        {
          "variant_id": "B03.var03",
          "version": null,
          "status": "planned",
          "planned_delta": "同一 MTID 按历史出动序号自动切换的独立能力探针"
        }
      ],
      "method_ids": [
        "M-B03"
      ],
      "limitations": [
        "explicit-mission-type-v1 是经确认可接受的业务替代合同，不声称 SIMLOX 能按出动历史自动识别首次与再次出动",
        "同一 MTID 按历史出动序号自动切换仍未确认；加油状态相关省略仍由 B05 独立验证",
        "首批显式任务类型模型不使用 MissionTurnround，不产生返航保障能力证据"
      ],
      "case_kind": "modeling_method",
      "publication_state": "not_published",
