        "child_intervals": [{"start": 0, "end": 7.75, "NR_NRA": 3, "NRN": 3}, {"start": 7.75, "end": 8, "NR_NRA": 2, "NRN": 1}, {"start": 8, "end": 36, "NR_NRA": 1, "NRN": 1}],
