        "draft_history": [seal(ROOT / p) for p in ["tmp/i03-var03-batch-contract-design-draft-v1-20261008.md", "tmp/i03-var03-batch-contract-design-20261008.md", "tmp/i03-var03-batch-contract-design-v2-20261008.md", "tmp/i03-var03-batch-contract-design-v3-20261008.md", "tmp/i03-var03-batch-contract-design-v4-20261008.md", "tmp/i03-var03-independent-design-v2-no-go-20261008.md", "tmp/i03-var03-ftmo-review-correction-20261008.md", "tmp/make-i03-var03-prospective-contract-design-failed-v1-20261008.py", "tmp/make-i03-var03-prospective-contract-design-v1-preserved-20261008.py", "tmp/i03-var03-prospective-contract-design-v1-preserved-20261008.json", "tmp/make-i03-var03-prospective-contract-design-v2-20261008.py", "tmp/i03-var03-prospective-contract-design-v2-20261008.json", "tmp/make-i03-var03-prospective-contract-design-v3-20261008.py", "tmp/i03-var03-prospective-contract-design-v3-20261008.json", "tmp/make-i03-var03-prospective-contract-design-v4-20261008.py", "tmp/i03-var03-prospective-contract-design-v4-20261008.json", "tmp/i03-var03-independent-contract-design-v4-no-go-20261008.md", "tmp/make-i03-var03-prospective-contract-design-v5-20261008.py", "tmp/i03-var03-prospective-contract-design-v5-20261008.json", "tmp/i03-var03-independent-contract-design-audit-v5-20261008.py", "tmp/i03-var03-independent-contract-design-v5-no-go-20261008.md"]],
