    "source_delta": {
        "base": {"path": "cases/simlox-air-support/I03-var01-crew-out-in-v1.0.0/out-input.json", "bytes": 43349, "sha256": "7f07e30d95f88228d9551cda93c0cf53e196f7473258096a86d2fa06949c262e"},
        "parent_model": {"database_version": 20160627, "tables": 32, "authored_rows": 24, "authored_cells": 220, "empty_tables": [t["name"] for t in parent_tables if not any(i["rows"] for i in t["instances"])], "tables_in_order": table_names},
