        "accepted_parent_original_raw": root_proof["parent_original_raw"],
        "accepted_prerequisite_indexes": [seal(CASE / p) for p in ["C03-var01-staffing-v0.1.1/evidence-index.json", "C08-partial-pool-v1.0.0/evidence-index.json", "C08-shift-maxut-v1.0.0/evidence-index.json"]],
