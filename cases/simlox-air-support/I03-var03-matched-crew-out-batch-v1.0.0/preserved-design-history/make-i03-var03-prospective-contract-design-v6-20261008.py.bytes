"""Author a prospective contract proposal only; never create case inputs or runs."""
from __future__ import annotations

import copy
import hashlib
import json
import pathlib
import struct
import subprocess

ROOT = pathlib.Path(__file__).resolve().parents[1]
CASE = ROOT / "cases/simlox-air-support"
PARENT = CASE / "I03-var01-crew-out-in-v1.0.0"
ROOT_PROOF = ROOT / "tmp/i03-var03-root-dependency-audit-20261008.json"
CATALOG = CASE / "publication-index-v1.json"
BASE = "8981e29847af744993aa6f7a66f689150ca124e5"
OUTPUT = ROOT / "tmp/i03-var03-prospective-contract-design-v6-20261008.json"


def seal(path: pathlib.Path) -> dict:
    b = path.read_bytes()
    return {"path": str(path.relative_to(ROOT)).replace("\\", "/"), "bytes": len(b), "sha256": hashlib.sha256(b).hexdigest()}


def f32(value: float) -> float:
    return struct.unpack("<f", struct.pack("<f", value))[0]


root_proof = json.loads(ROOT_PROOF.read_text(encoding="utf-8"))
parent_index = json.loads((PARENT / "evidence-index.json").read_text(encoding="utf-8"))
parent_source = json.loads((PARENT / "out-input.json").read_text(encoding="utf-8"))
parent_tables = parent_source["model"]["tables"]
assert len(parent_tables) == 32
assert sum(len(i["rows"]) for t in parent_tables for i in t["instances"]) == 24
assert sum(len(row) for t in parent_tables for i in t["instances"] for row in i["rows"]) == 220
assert sum(not any(i["rows"] for i in t["instances"]) for t in parent_tables) == 11
table_names = [t["name"] for t in parent_tables]

reference_gate = json.loads((CASE / "I03-var02-idle-crew-out-v1.0.2/contract.json").read_text(encoding="utf-8"))["report_gate"]
report_gate = copy.deepcopy(reference_gate)
report_gate.pop("source_event_integrals_aircraft_hours")
report_gate.pop("source_event_counts")
report_gate["source_event_integrals_by_arm"] = {
    "control_out1": {"NSYRY": 66, "NSYMA": 6, "NSYMO": 4, "NSYMP": 2, "NSYMR": 0, "NSYA": 72, "FTMO": 2, "STACC": 4},
    "child_out2": {"NSYRY": 65, "NSYMA": 7, "NSYMO": 4, "NSYMP": 2.5, "NSYMR": 0.5, "NSYA": 72, "FTMO": 2, "STACC": 4},
}
report_gate["source_event_counts_by_arm"] = {arm: {"NPSTA": 4, "NPSUC": 4} for arm in ("control_out1", "child_out2")}
report_gate["system_per_bin_formula"] = {
    "bins": "For each j=0..71 use exact [j/2,(j+1)/2); exposure([a,b),bin)=length(intersection)/0.5. Derive a,b from authored mission and linked typed prep/mission/return events; no candidate report reads in expectation construction.",
    "assigned": "sum over 2 aircraft x 2 waves of exposure(preparation_start,return); NSYMA=assigned, NSYRY=2-assigned, NSYA=2",
    "mission": "sum aircraft exposure(launch,return); NSYMO=mission, STACC=mission; FTMO=mission/2 is bounded native per-system fraction, so 72 raw FTMO rows sum4 and their 0.5-hour integral2",
    "preparation": "For each wave: NSYMP=2*exposure(prep_start,first_prep_end)+exposure(first_prep_end,last_prep_end); NSYMR=exposure(first_prep_end,last_prep_end). These fields overlap and must not be treated as an exclusive partition.",
    "counts": "NPSTA=two starts in their prep_start bin; NPSUC=one per matching first/last completion in its bin; exact four each",
    "other_fields": "Every other SystemResults field is in the exhaustive fixed field-class map inherited below; source-event zero, bounded native presentation zero or no-downtime null. No broad default-zero for unknown fields.",
}
report_gate["resource_fields"]["per_bin_expected"] = {
    "control_out1": "NR=NRA=NRN=3 on [0,7.75), 2 on [7.75,36); NRUM=2 [7.5,8) and [19.5,20); NRW=0",
    "child_out2": "NR=NRA=3 [0,7.75), 2 [7.75,8), 1 [8,36); NRN=3 [0,7.75),1 [7.75,36); NRUM=2 [7.5,8),1 [19.5,20.5); NRW=1 [19.5,20), otherwise0",
    "clock_separation": "NR/NRA local physically held resources change on positive task start; NRN nominal schedule changes by full requested TFQTY at h7.75. Transfer backorder is not NRW, which is a waiting preparation task.",
}
report_gate["resource_fields"]["total_expected_float32"] = {
    "control_out1": {"NR": f32(79.75/36), "NRA": f32(79.75/36), "NRN": f32(79.75/36), "NRUM": f32(2/36), "NRW": 0},
    "child_out2": {"NR": f32(51.75/36), "NRA": f32(51.75/36), "NRN": f32(51.5/36), "NRUM": f32(2/36), "NRW": f32(.5/36)},
}
report_gate["resource_fields"]["all_other_total_numeric_zero"] = True
report_gate["numeric_comparison"] = {
    "exact": "All source times and expected event boundaries 0,7.5,7.75,8,9,19.5,20,20.5,21,21.5,36 are binary-exact. Exact finite numeric comparison for source, discrete, zero, null, whole-bin and fractional [7.5,8) cells; reject bool as numeric and NaN/Inf. No half-last-decimal tolerance for authored 7.75.",
    "binary32_means": "For exactly NR,NRA,NRN,NRUM,NRW in ResourceResultsTotal, compare parsed finite JSON numeric value exactly to binary32(typed integral/36). Other total fields exact zero or typed identity.",
    "unexpected_observed_edge": "NO_GO. All prospective source and event edges in this exact case are binary quarter- or half-hours, so there is no uncertainty class or tolerance escape for h7.75, h8, or any other forecast edge. A divergent observed edge requires a separately versioned contract after preserving the failed run.",
    "metadata": "Full recursive type-exact compare of root/table/column/instance keys, names, order, datatypes and key Boolean, duplicate-key rejection. Native trailing comma repaired only in an in-memory parsing copy; original bytes sealed.",
}
report_gate["result_summary_expected"] = reference_gate["result_summary_expected"]
report_gate["full_cell_oracle"] = "For each arm independently derive all 5210 expectations from that arm's source and fully typed events using the declared field classes, interval formulas and bounded presentation constants. Never copy accepted parent dynamic cells or fit child report. Cross-arm difference is diagnostic only. Unknown physical formula or unexplained cell is NO_GO."

cat_bytes = CATALOG.read_bytes()
git_record = subprocess.check_output(["git", "ls-tree", BASE, "--", "cases/simlox-air-support/publication-index-v1.json"], cwd=ROOT).decode().strip()
oid = git_record.split()[2]
git_bytes = subprocess.check_output(["git", "cat-file", "blob", oid], cwd=ROOT)
current_catalog = json.loads(cat_bytes)
assert len(current_catalog["entries"]) == 493
assert current_catalog["schema"] == "simlox-air-support-publication-index/v1"
catalog_meta = {k: current_catalog[k] for k in current_catalog if k != "entries"}

doc_paths = ["AGENTS.md", "README.md", "docs/architecture.md", "docs/semantic-baseline.md", "docs/roadmap.md", "cases/simlox-air-support/execution-plan-v2.md", "cases/simlox-air-support/ssh-cli-acceptance-policy-v1.md", "cases/simlox-air-support/catalog-v2.json"]
installed = json.loads((CASE / "I03-var11-out-unarrived-horizon-v1.0.0/contract.json").read_text(encoding="utf-8"))["source_lineage"]["installed"]

contract = {
    "schema": "simlox-air-support-i03-var03-prospective-contract-design/v6",
