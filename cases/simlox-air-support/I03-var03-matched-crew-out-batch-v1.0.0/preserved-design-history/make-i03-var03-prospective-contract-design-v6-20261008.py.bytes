assert len(contract["report_gate"]["topology"]) == 6
assert sum(t["rows"] * len(t["columns"]) for t in contract["report_gate"]["topology"]) == 5210
assert len(contract["source_lineage"]["accepted_parent_source_disk_git_at_base"]) == 17
