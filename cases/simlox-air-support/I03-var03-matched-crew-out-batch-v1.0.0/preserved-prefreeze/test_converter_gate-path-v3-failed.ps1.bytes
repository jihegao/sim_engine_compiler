param([switch]$WriteFixture)
$ErrorActionPreference='Stop'
$case=(Resolve-Path $PSScriptRoot).Path
$runner=Join-Path $case 'run_native_ssh.ps1'
$tokens=$null;$errors=$null
$ast=[System.Management.Automation.Language.Parser]::ParseFile($runner,[ref]$tokens,[ref]$errors)
if (@($errors).Count -ne 0) { throw 'runner PowerShell AST parse failed' }
$functions=@($ast.FindAll({param($node) $node -is [System.Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -eq 'Assert-ConverterLog'},$true))
if ($functions.Count -ne 1) { throw 'expected one production converter function' }
Invoke-Expression $functions[0].Extent.Text

$parent=Join-Path (Split-Path $case -Parent) 'I03-var01-crew-out-in-v1.0.0\runs\i03-var01-crew-transfer-v100-ssh-20261005-01\out-run.log'
$parentBody=Get-Content -LiteralPath $parent -Raw -Encoding UTF8
$warning='rec 1: (warning #108) Enabling simulation log may generate extensive data in log file'
if ([regex]::Matches($parentBody,[regex]::Escape($warning)).Count -ne 1) { throw 'sealed parent warning occurs other than once' }

function Set-LogLine([string]$body,[string]$label,[string]$value) {
  $pattern='(?m)^'+[regex]::Escape($label)+': [^\r\n]+'
  $matches=[regex]::Matches($body,$pattern)
  if ($matches.Count -ne 1) { throw "expected one $label line" }
  return $body.Replace($matches[0].Value,($label+': '+$value))
}

$root=Join-Path $case 'test-output\converter-gate-local-v3'
if ($WriteFixture) {
  if (Test-Path -LiteralPath $root) { throw 'converter test output already exists' }
  New-Item -ItemType Directory -Path $root | Out-Null
}
$names=@('baseline','changed_message','wrong_owner','duplicate_warning','extra_note',
  'extra_mixed_warning','stale_input_path','stale_output_path','stale_file_path')
$rejected=0
foreach($name in $names) {
  if (-not $WriteFixture) { continue }
  $dir=Join-Path $root $name
  New-Item -ItemType Directory -Path $dir | Out-Null
  $sxi=[IO.Path]::GetFullPath((Join-Path $dir 'model.sxi'))
  $sxo=[IO.Path]::GetFullPath((Join-Path $dir 'model.sxo'))
  $body=Set-LogLine $parentBody 'Input file' $sxi
  $body=Set-LogLine $body 'Output file' $sxo
  $body=Set-LogLine $body 'File' ($sxi.Replace('\','/'))
  switch ($name) {
    changed_message { $body=$body.Replace($warning,$warning+' altered') }
    wrong_owner { $body=$body.Replace('Form: Control','Form: System') }
    duplicate_warning { $body=$body.Replace($warning,$warning+[Environment]::NewLine+$warning) }
    extra_note { $body+=[Environment]::NewLine+'rec 2: (note #17) extra' }
    extra_mixed_warning { $body+=[Environment]::NewLine+'rec 2: (WARNING #17) extra' }
    stale_input_path { $body=Set-LogLine $body 'Input file' ([IO.Path]::GetFullPath((Join-Path $dir 'other.sxi'))) }
    stale_output_path { $body=Set-LogLine $body 'Output file' ([IO.Path]::GetFullPath((Join-Path $dir 'other.sxo'))) }
    stale_file_path { $body=Set-LogLine $body 'File' (([IO.Path]::GetFullPath((Join-Path $dir 'other.sxi'))).Replace('\','/')) }
  }
  $path=Join-Path $dir 'run.log'
  [System.IO.File]::WriteAllText($path,$body,[System.Text.UTF8Encoding]::new($false))
  $script:converterLogPin=@{bytes=(Get-Item -LiteralPath $path).Length;
    sha256=(Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()}
  $passed=$true
  $errorText=$null
  try { Assert-ConverterLog $dir } catch { $passed=$false; $errorText=$_.Exception.Message }
  if ($name -eq 'baseline') { if (-not $passed) { throw "production converter gate rejected synthetic path-rebound parent log: $errorText" } }
  else { if ($passed) { throw "production converter gate accepted $name" }; $rejected++ }
}
[ordered]@{schema='i03-var03-converter-local-test/v2';pure=$true;native_calls=0;
  executed=$WriteFixture.IsPresent;semantic_rejections=$rejected} | ConvertTo-Json -Compress
