"""Read-only per-arm physical trace and full 5,210-cell report validator."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re

from build import typed_equal
from check_roundtrip import parse
from event_ledger import validate as event_validate
from report_oracle import check_report
from source_gate import INPUT_SHA, RUN_IDS

HERE = Path(__file__).resolve().parent
SCHEMA = "i03-var03-matched-out-behavior/v1"


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def converter(text: str) -> None:
    assert len(re.findall(r"^Input conversion completed\. Errors: 0, Warnings: 2, Notes: 0$", text, re.M)) == 1
    warnings = re.findall(r"(?m)^Form: ([^\r\n]+)\r?\n(rec [^\r\n]+)\r?$", text)
    assert warnings == [
        ("Control", "rec 1: (warning #108) Enabling simulation log may generate extensive data in log file"),
        ("System", "rec 1: (warning #126) This system contains no items: TEACH-AIR-01"),
    ], warnings
    assert len(re.findall(r"(?m)^Form: ", text)) == len(re.findall(r"(?m)^rec ", text)) == 2
    assert re.findall(r"\bwarning\s*#(\d+)", text) == ["108", "126"]
    assert not re.findall(r"\b(?:error|notice)\s*#(\d+)", text, re.I)
    assert text.count("Starting simulation") == text.count("Saving results") == 1


def check(run: Path, arm: str, log_override: str | None = None, report_override: dict | None = None) -> dict:
    assert arm in INPUT_SHA and run.name == RUN_IDS[arm]
    assert sha(run / "input.json") == INPUT_SHA[arm]
    assert typed_equal(parse(HERE / f"{arm}-input.json"), parse(run / "input.json"))
    log = log_override if log_override is not None else (run / "model.log").read_text(encoding="utf-8-sig")
    report = report_override if report_override is not None else parse(run / "report-raw.json")
    timeline = event_validate(log, arm)
    converter((run / "run.log").read_text(encoding="utf-8-sig"))
    cells = check_report(report, timeline, arm)
    assert timeline["terminal"] == ({"local": 1, "booked": 0, "transfer_backorder": 0, "ready_aircraft": 2}
                                    if arm == "child_out2" else
                                    {"local": 2, "booked": 0, "transfer_backorder": 0, "ready_aircraft": 2})
    return {"schema": SCHEMA, "arm": arm, "passed": True, "issues": [],
            "run_id": RUN_IDS[arm], "input_sha256": INPUT_SHA[arm],
            "report_cell_checks": cells, "typed_event_records": timeline["typed_events"],
            "timeline": timeline}


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("run", type=Path)
    parser.add_argument("arm", choices=tuple(INPUT_SHA))
    args = parser.parse_args()
    try:
        result = check(args.run, args.arm)
    except Exception as exc:
        result = {"schema": SCHEMA, "arm": args.arm, "passed": False, "issues": [f"{type(exc).__name__}: {exc}"]}
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    raise SystemExit(0 if result["passed"] else 1)
