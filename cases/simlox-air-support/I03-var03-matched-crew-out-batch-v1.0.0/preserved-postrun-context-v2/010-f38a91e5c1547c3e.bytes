"""Capture unchanged independent reader on sealed originals; no native calls."""
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys

REPO = Path(__file__).resolve().parents[1]
CASE = REPO / 'cases/simlox-air-support/I03-var03-matched-crew-out-batch-v1.0.0'
assert len(sys.argv) == 2 and sys.argv[1] in ('control', 'both')
mode = sys.argv[1]
OUT = REPO / f'tmp/i03-var03-root-independent-sealed-{mode}-20261008-01'
assert not OUT.exists(), 'one-time proof output; preserve prior failures'

def pin(path):
    raw = path.read_bytes()
    return {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}

def freeze(path):
    os.chmod(path, stat.S_IREAD)
    assert not path.stat().st_mode & stat.S_IWRITE

method = CASE / 'review/independent_replay.py'
assert pin(method) == {'bytes': 63558, 'sha256': 'c45bcc2c696031ce04a687086fa266aa01446a2504a02f93aa053d8163ede037'}
before = {}
for run in sorted((CASE / 'runs').iterdir()):
    for path in sorted(run.iterdir()):
        assert path.is_file() and not path.stat().st_mode & stat.S_IWRITE
        before[str(path)] = pin(path)
assert len(before) == (25 if mode == 'control' else 50)
OUT.mkdir()
argv = [sys.executable, '-X', 'utf8', '-B', str(method), '--sealed-' + mode]
result = subprocess.run(argv, cwd=CASE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
streams = {}
for name, raw in [('stdout', result.stdout), ('stderr', result.stderr)]:
    path = OUT / (name + '.bin')
    path.write_bytes(raw)
    freeze(path)
    streams[name] = {'path': str(path), **pin(path)}
unchanged = all(pin(Path(path)) == wanted for path, wanted in before.items())
receipt = {'schema': 'i03-var03-root-original-independent-sealed-proof/v1',
           'mode': mode, 'argv': argv, 'exit_code': result.returncode,
           'streams': streams, 'method': pin(method), 'raw_files': before,
           'raw_unchanged_after': unchanged, 'new_native_calls': 0,
           'decision': 'GO_REPLAY_METHOD_ONLY' if result.returncode == 0 and result.stderr == b'' and unchanged else 'NO_GO_PRESERVED'}
path = OUT / 'receipt.json'
path.write_bytes((json.dumps(receipt, indent=2) + '\n').encode())
freeze(path)
print(json.dumps({'receipt': str(path), **pin(path), 'decision': receipt['decision']}))
assert receipt['decision'] == 'GO_REPLAY_METHOD_ONLY'
