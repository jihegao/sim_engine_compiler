"""Read-only fingerprint of the current checker carrier; never native."""
from pathlib import Path
import hashlib, json, stat, sys
p=Path(sys.executable).resolve()
assert p == Path(r'C:\Users\user\.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe')
s=p.stat(); b=p.read_bytes()
pin={'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest(),
     'mode':stat.S_IMODE(s.st_mode),'attributes':s.st_file_attributes}
assert (pin['bytes'],pin['sha256'],pin['mode'],pin['attributes']) == (106448,
    '10d845f50a2af64e3500bb2fcb348b5bc98a75d8ddada63e45ba1da6a1fc79d1',511,32)
assert p.read_bytes() == b and p.stat().st_mode == s.st_mode and p.stat().st_file_attributes == s.st_file_attributes
print(json.dumps({'schema':'i05-var07-root-python-runtime-pin/v100',
    'role':'runtime:python','runtime':pin,'selected_reference_count_unchanged':100,
    'selected_unique_original_count_unchanged':98,'native_calls':0}))
