}


def digest(blob: bytes) -> str:
    return hashlib.sha256(blob).hexdigest()


def snap(path: Path) -> dict:
    assert path.is_file() and not path.is_symlink(), path
    info = path.stat()
    return {"bytes": info.st_size, "sha256": digest(path.read_bytes()),
            "mode": stat.S_IMODE(info.st_mode),
            "attributes": getattr(info, "st_file_attributes", None)}


def pin(path: Path, expected: tuple[int, str]) -> dict:
    value = snap(path)
    assert (value["bytes"], value["sha256"]) == expected, path
    return value


def no_duplicate(pairs: list[tuple[str, object]]) -> dict:
    result = {}
    for key, value in pairs:
        assert key not in result, key
        result[key] = value
    return result


def load(path: Path, *, receipt_bom: bool = False) -> dict:
    data = path.read_bytes()
    if receipt_bom:
        assert data.startswith(b"\xef\xbb\xbf"), path
        data = data[3:]
        assert not data.startswith(b"\xef\xbb\xbf"), path
    else:
        assert not data.startswith(b"\xef\xbb\xbf"), path
    obj = json.loads(data.decode("utf-8"), object_pairs_hook=no_duplicate,
                     parse_constant=lambda x: (_ for _ in ()).throw(AssertionError(x)))
    assert type(obj) is dict, path
    return obj


def same(a: object, b: object) -> bool:
    if type(a) is not type(b):
        return False
    if isinstance(a, dict):
        return a.keys() == b.keys() and all(same(a[k], b[k]) for k in a)
    if isinstance(a, list):
        return len(a) == len(b) and all(same(x, y) for x, y in zip(a, b))
    return a == b


def git(*args: str) -> bytes:
    proc = subprocess.run(["git", *args], cwd=REPO, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=False)
    assert proc.returncode == 0, (args, proc.stderr.decode("utf-8", "replace")[:500])
    return proc.stdout


def pair(path: Path, expected: tuple[int, str], oid_expected: str | None = None) -> dict:
    rel = path.relative_to(REPO).as_posix()
    before = pin(path, expected)
    oid = git("rev-parse", f"{MERGED_BASE}:{rel}").decode("ascii").strip()
    assert len(oid) == 40
    if oid_expected is not None:
        assert oid == oid_expected, rel
    blob = git("cat-file", "blob", oid)
    assert (len(blob), digest(blob)) == expected and blob == path.read_bytes(), rel
    assert snap(path) == before, rel
    return {"path": rel, "oid": oid, **before}


def run_check(role: str, run_id: str, invocation_pin: tuple[int, str],
              closure_pin: tuple[int, str]) -> tuple[list[dict], dict]:
    base = PARENT / "runs" / run_id
    inv_path, clo_path = base / "invocation.json", base / "closure.json"
    inv_before, clo_before = pin(inv_path, invocation_pin), pin(clo_path, closure_pin)
    inv, closure = load(inv_path, receipt_bom=True), load(clo_path, receipt_bom=True)
    assert inv["run_id"] == closure["run_id"] == run_id
    assert closure["invocation_sha256"] == invocation_pin[1]
    assert closure["error"] is None
    assert same(closure["source_hashes_before"], closure["source_hashes_after"])
    source = closure["source_hashes_before"]
    assert source["input"] == SOURCE_PINS["control-input.json" if role == "control" else "turnround-input.json"][1]
    assert source["parent"] == B02_PARENT_INPUT_SHA
    for name, rel in {"contract": "contract.json",
                      "builder": "build.py", "checker": "check_roundtrip.py",
                      "runner_script": "run_native_ssh.ps1"}.items():
        assert source[name] == SOURCE_PINS[rel][1], (role, name)
    assert len(closure["raw"]) == 12
    assert closure["raw"]["input.json"]["sha256"] == source["input"]
    rows = []
    for name, expected in closure["raw"].items():
        assert Path(name).name == name
        path = base / name
        before = pin(path, (expected["bytes"], expected["sha256"]))
        rows.append({"run_role": role, "name": name, "path": str(path), **before})
    assert snap(inv_path) == inv_before and snap(clo_path) == clo_before
    return rows, {"run_id": run_id,
                  "invocation_path": str(inv_path), "invocation": inv_before,
                  "closure_path": str(clo_path), "closure": clo_before,
                  "source_hashes": source}


def excluded_v100() -> tuple[list[dict], list[dict]]:
    """Keep current v1.0.0 raw identities separate; they are not accepted behavior."""
    records, receipts = [], []
    for run_id, (inv_pin, closure_pin) in EXCLUDED_RUNS.items():
        base = EXCLUDED / "runs" / run_id
        inv_path, closure_path = base / "invocation.json", base / "closure.json"
        inv_before, closure_before = pin(inv_path, inv_pin), pin(closure_path, closure_pin)
        inv, closure = load(inv_path, receipt_bom=True), load(closure_path, receipt_bom=True)
        assert inv["run_id"] == run_id
        assert closure["run_id"] == run_id and closure["publication_state"] == "not_published"
        assert closure["invocation_sha256"] == inv_pin[1]
        assert same(closure["source_hashes_before"], closure["source_hashes_after"])
        assert len(closure["raw"]) == 12
        for name, expected in closure["raw"].items():
            path = base / name
            records.append({"run_id": run_id, "name": name, "path": str(path),
                            **pin(path, (expected["bytes"], expected["sha256"]))})
        assert snap(inv_path) == inv_before and snap(closure_path) == closure_before
        receipts.append({"run_id": run_id, "accepted": False,
                         "invocation_path": str(inv_path), "invocation": inv_before,
                         "closure_path": str(closure_path), "closure": closure_before})
    assert len(records) == 24
    return records, receipts


def main() -> None:
    assert LIVE is not None and LIVE_PIN is not None  # no unpinned live source
    assert REPO.name == "repo" and Path(git("rev-parse", "--show-toplevel").decode().strip()).resolve() == REPO
    pin(LIVE, LIVE_PIN)
    live = load(LIVE)
    assert live["candidate"] == "I05.var07" and live["tracked_tree_clean"] is True
    assert live["refs"]["refs/heads/simlox/main"] == MERGED_BASE
    assert live["open_simlox_main_prs"] == []
    pin(CATALOG, CATALOG_PIN)
    catalog = load(CATALOG)
    assert catalog["schema"] == "simlox-air-support-publication-index/v1"
    entries = catalog["entries"]
    assert type(entries) is list and len(entries) == 505
    ids = [r["publication_id"] for r in entries]
    assert len(ids) == len(set(ids)) and set(ids) >= REQUIRED_PUBLICATIONS
    assert ids[-1] == "I05.var04.scheduled_item_repair.1.0.3"
    assert not any(ident.startswith("I05.var07.") for ident in ids)
    entry = next(r for r in entries if r["publication_id"] == "B04.cross_midnight_turnround.1.0.1")
    assert entry["package"] == PARENT.name
    assert entry["evidence"] == f"{PARENT.name}/cli-scope-signoff-2026-09-30.md"
    git_oid = git("rev-parse", f"{MERGED_BASE}:cases/simlox-air-support/publication-index-v1.json").decode().strip()
    git_catalog = git("cat-file", "blob", git_oid)
    assert CATALOG.read_bytes().replace(b"\r\n", b"\n") == git_catalog
    assert CATALOG.read_bytes() != git_catalog

    pin(PRIOR_MAP, PRIOR_MAP_PIN)
    prior = load(PRIOR_MAP)
    assert prior["decision"] == "PASS_CANDIDATE_DEPENDENCY_BYTES_ONLY"
    assert prior["native_calls"] == prior["accepted_checker_calls"] == 0
    assert len(prior["source_pairs"]) == 21
    dependency_pairs = []
    for row in prior["source_pairs"]:
        dependency_pairs.append({"role": row["role"], **pair(REPO / row["path"],
            (row["bytes"], row["sha256"]), row["git_oid"])})
    assert len({r["role"] for r in dependency_pairs}) == len({r["path"] for r in dependency_pairs}) == 21

    accepted_sources = [pair(PARENT / rel, expected) for rel, expected in SOURCE_PINS.items()]
    assert len(accepted_sources) == 16 and len({r["path"] for r in accepted_sources}) == 16
    no_turnround = load(PARENT / "control-input.json")
    selected_parent = load(PARENT / "turnround-input.json")
    assert all(t["name"] != "MissionTurnround" for t in no_turnround["model"]["tables"])
    turnround_tables = [t for t in selected_parent["model"]["tables"] if t["name"] == "MissionTurnround"]
    assert len(turnround_tables) == 1
    assert [c["name"] for c in turnround_tables[0]["columns"]] == [
        "MTID", "SID", "STID", "DURN", "TID", "DURND", "NOTE"]
    assert turnround_tables[0]["instances"][0]["rows"] == [
        ["BASIC-MISSION", "TEACH-AIR-01", "BASE-01", 1.0, None, None, None]]
    contract = load(PARENT / "contract.json")
    assert contract["case_id"] == "B04" and contract["version"] == "1.0.1"
    assert contract["configuration"]["turnround_variant"].endswith("no resources or subtasks")
    independent = load(PARENT / "review/independent-turnround-2026-09-30.json")
    assert independent["passed"] is True and independent["failed_count"] == 0
    assert independent["passed_count"] == 72 and independent["failed"] == []
    signoff = (PARENT / "cli-scope-signoff-2026-09-30.md").read_text(encoding="utf-8")
    assert "native_behavior_accepted" in signoff and "paired" in signoff
    assert RUNS["control"][2][1] in signoff and RUNS["turnround"][2][1] in signoff
    accepted_raw, accepted_runs = [], []
    for role, (run_id, invocation_pin, closure_pin) in RUNS.items():
        rows, summary = run_check(role, run_id, invocation_pin, closure_pin)
        accepted_raw.extend(rows)
        accepted_runs.append({"role": role, **summary})
    assert len(accepted_raw) == 24 and len({r["path"] for r in accepted_raw}) == 24
    excluded_raw, excluded_receipts = excluded_v100()

    pin(MANUAL_SOURCES, MANUAL_SOURCES_PIN)
    manual = load(MANUAL_SOURCES)
    manual_hash = {r["source_id"]: r["sha256"] for r in manual["sources"]}
    assert manual_hash["SIMLOX-2017-USERS-REFERENCE"] == INSTALLED["manual"][1]
    assert manual_hash["SIMLOX-2017-TABLE-DICTIONARY"] == INSTALLED["dictionary"][1]
    installed = {}
    for role, (path, expected_sha) in INSTALLED.items():
        before = snap(path)
        assert before["sha256"] == expected_sha and snap(path) == before
        installed[role] = {"path": str(path), **before}
    assert installed["executable"]["sha256"] == accepted_runs[1]["source_hashes"]["simlox_exe"]
    assert pin(CATALOG, CATALOG_PIN)["sha256"] == CATALOG_PIN[1]
    assert pin(PRIOR_MAP, PRIOR_MAP_PIN)["sha256"] == PRIOR_MAP_PIN[1]
    protected = [(LIVE, pin(LIVE, LIVE_PIN)), (CATALOG, pin(CATALOG, CATALOG_PIN)),
                 (PRIOR_MAP, pin(PRIOR_MAP, PRIOR_MAP_PIN)),
                 (MANUAL_SOURCES, pin(MANUAL_SOURCES, MANUAL_SOURCES_PIN))]
    protected.extend((REPO / row["path"], {k: row[k] for k in ("bytes", "sha256", "mode", "attributes")})
                     for row in dependency_pairs + accepted_sources)
    protected.extend((Path(row["path"]), {k: row[k] for k in ("bytes", "sha256", "mode", "attributes")})
                     for row in accepted_raw + excluded_raw)
    for run in accepted_runs + excluded_receipts:
        protected += [(Path(run["invocation_path"]), run["invocation"]),
                      (Path(run["closure_path"]), run["closure"])]
    protected.extend((Path(row["path"]), {k: row[k] for k in ("bytes", "sha256", "mode", "attributes")})
                     for row in installed.values())
    by_path: dict[str, tuple[Path, dict]] = {}
    for path, before in protected:
        key = str(path.resolve()).casefold()
        if key in by_path:
            assert by_path[key][1] == before, path  # prior dependency and B04 role aliases
        else:
            by_path[key] = (path, before)
    for path, before in by_path.values():
        assert snap(path) == before, path
    print(json.dumps({
        "schema": "i05-var07-root-selection-byte-audit/v100",
        "decision": "ELIGIBLE_FOR_PROSPECTIVE_CONTRACT_REVIEW_ONLY",
        "catalog_entries": 505,
        "catalog_local": {"path": str(CATALOG), **snap(CATALOG)},
        "catalog_git": {"oid": git_oid, "bytes": len(git_catalog), "sha256": digest(git_catalog)},
        "candidate_published": False,
        "required_publications": sorted(REQUIRED_PUBLICATIONS),
        "prior_dependency_pairs": dependency_pairs,
        "accepted_parent_source_pairs": accepted_sources,
        "selected_parent_arm": {"role": "B04 turnround, not B04 no-turnround control",
                                "path": str(PARENT / "turnround-input.json"),
                                "sha256": SOURCE_PINS["turnround-input.json"][1],
                                "roundtrip_turnround_duration_hours": 1.0,
                                "turnround_subtask_id": None},
        "accepted_parent_runs": accepted_runs,
        "accepted_parent_raw_originals": accepted_raw,
        "accepted_parent_raw_count": 24,
        "excluded_v100_raw_observed": excluded_raw,
        "excluded_v100_raw_count": len(excluded_raw),
        "excluded_v100_receipts_observed": excluded_receipts,
        "excluded_v100_receipt_count": 4,
        "protected_original_count": len(by_path),
        "role_reference_count": len(protected),
        "installed_sources": installed,
        "native_calls": 0, "accepted_checker_calls": 0,
        "meaning": "source/byte eligibility only; no I05.var07 behavior accepted",
    }, sort_keys=True))


if __name__ == "__main__":
    main()
