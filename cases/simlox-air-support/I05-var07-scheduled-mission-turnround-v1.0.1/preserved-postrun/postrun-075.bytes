"""Capture fresh SSH GUI/session/mutex guard only; never dispatch native work."""
from pathlib import Path
import datetime as dt, hashlib, json, stat, subprocess, uuid
R=Path(__file__).resolve().parents[1]
G=R/'tmp/issue18-next-owner-guard-20261008.ps1'
def pin(p):
 b=p.read_bytes(); return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
assert pin(G)=={'bytes':2081,'sha256':'e50559f262d708afd1bd261986089ca807af1c80624d87a8c2c3c5fa4b04077f'}
assert not G.stat().st_mode&stat.S_IWRITE
O=R/'tmp/i04-var06-root-publication-guards-v100-20261008'/(dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')+'-'+uuid.uuid4().hex[:8])
O.mkdir(parents=True,exist_ok=False)
argv=['ssh','-n','-o','BatchMode=yes','-o','ConnectTimeout=10','-i','C:/Users/user/.ssh/id_rsa','user@127.0.0.1','powershell.exe','-NoProfile','-NonInteractive','-File',G.as_posix()]
before=pin(G)
with (O/'stdout.bin').open('xb') as out,(O/'stderr.bin').open('xb') as err:
 code=subprocess.run(argv,cwd=R,stdout=out,stderr=err).returncode
after=pin(G); observed=None; failure=None
try:
 assert type(code) is int and code==0 and (O/'stderr.bin').read_bytes()==b'' and before==after
 observed=json.loads((O/'stdout.bin').read_bytes())
 assert all(observed[k] is True for k in ('ssh_present','sshd_ancestor','mutex_free'))
 assert observed['self_session']==0 and observed['powershell_major']==5
 assert observed['session_query_exit']==0 and observed['active_gui_session1_count']==1
 assert observed['runner_candidates']==[] and len(observed['native'])==1
 gui=observed['native'][0]
 assert gui['pid']==13340 and gui['session']==1 and gui['start_ms']==1790590196826 and gui['responding'] is True
except BaseException as e: failure=type(e).__name__+': '+str(e)
body={'schema':'i04-var06-publication-guard/v100','utc':dt.datetime.now(dt.timezone.utc).isoformat(),'native_dispatch':False,'argv':argv,'actual_exit':code,'guard_before':before,'guard_after':after,'streams':{n:pin(O/n) for n in ('stdout.bin','stderr.bin')},'observed':observed,'decision':'PASS_GUARDS_ONLY' if failure is None else 'NO_GO_PRESERVED','failure':failure,'method':pin(Path(__file__))}
with (O/'receipt.json').open('xb') as f:f.write((json.dumps(body,indent=2)+'\n').encode())
for p in O.iterdir():p.chmod(stat.S_IREAD)
print(json.dumps({'receipt':str(O/'receipt.json'),**pin(O/'receipt.json'),'decision':body['decision'],'actual_exit':code,'observed':observed,'failure':failure}))
assert failure is None
