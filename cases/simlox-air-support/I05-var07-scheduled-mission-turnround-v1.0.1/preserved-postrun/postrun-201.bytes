def controlled(path: Path) -> Path:
    absolute = path.absolute()
    assert absolute.is_relative_to(REPO)
    cursor = absolute
    while cursor != REPO.parent:
        if cursor.exists():
            assert not cursor.is_symlink()
            if hasattr(cursor, "is_junction"):
                assert not cursor.is_junction()
            assert not (getattr(cursor.stat(), "st_file_attributes", 0) & 0x400)
        cursor = cursor.parent
    return absolute

def pin(path: Path, bytes: int | None = None, sha256: str | None = None) -> dict:
    path = controlled(path)
    assert path.is_file() and path.stat().st_mode & stat.S_IWRITE == 0
    attributes = getattr(path.stat(), "st_file_attributes", 0)
    assert attributes & 1
    data = path.read_bytes()
    actual = {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest(),
              "mode": stat.S_IMODE(path.stat().st_mode), "attributes": attributes}
    if bytes is not None:
        assert actual["bytes"] == bytes
    if sha256 is not None:
        assert actual["sha256"] == sha256
    return actual

def recheck(value: object) -> None:
    if type(value) is dict:
        if {"path", "bytes", "sha256", "mode", "attributes"} <= value.keys():
            again = pin(Path(value["path"]), value["bytes"], value["sha256"])
            assert all(value[key] == again[key] for key in ("path", "bytes", "sha256", "mode", "attributes"))
        for key, item in value.items():
            if key not in {"path", "bytes", "sha256", "mode", "attributes"}:
                recheck(item)
    elif type(value) is list:
        for item in value:
            recheck(item)

def json_file(path: Path) -> dict:
    return json.loads(path.read_bytes().decode("utf-8"))

def triplet(folder: Path, size: int, sha: str) -> tuple[dict, dict]:
    rp = folder / "receipt.json"
    record = pin(rp, size, sha)
    receipt = json_file(rp)
    for name in ("stdout.bin", "stderr.bin"):
        target = receipt["streams"][name]
        record[name] = pin(folder / name, target["bytes"], target["sha256"])
    assert receipt["method_before"] == receipt["method_after"]
    return record, receipt

def extra_inner(stdout: Path, mandatory: bool) -> dict | None:
    try:
        body = json.loads(stdout.read_bytes().decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        body = None
    if not isinstance(body, dict) or "receipt" not in body:
        assert not mandatory
        return None
    assert mandatory
    path = controlled(Path(body["receipt"]))
    assert path.is_relative_to(REPO / "tmp")
    result = pin(path, body["bytes"], body["sha256"])
    inner = json_file(path)
    if "streams" in inner:
        for name in ("stdout.bin", "stderr.bin"):
            target = inner["streams"][name]
            result[name] = pin(path.parent / name, target["bytes"], target["sha256"])
    if inner.get("schema") == "i04-var06-publication-guard/v100":
        assert inner["actual_exit"] == 0 and inner["native_dispatch"] is False
        assert inner["guard_before"] == inner["guard_after"]
        result["guard_script"] = pin(Path(inner["argv"][-1]), **inner["guard_before"])
    return result

def command_stage(version: str, name: str, size: int, sha: str, spec_name: str) -> dict:
    folder = REPO / (COMMAND_BASE + version) / name
    evidence, receipt = triplet(folder, size, sha)
    assert receipt["schema"] == f"i05-var07-root-command-proof/{version[:4]}"
    assert receipt["actual_exit"] == (1 if "local-test-converter-gate" in name else 0)
    assert receipt["native_dispatch"] is ("canonical-native-" in name)
    argv = receipt["argv"]
    method_index = 5 if Path(argv[0]).stem.lower() == "powershell" else 4
    method = pin(Path(argv[method_index]), **receipt["method_before"]["method"])
    capture_name = f"i05-var07-root-command-capture-{version[:4]}-20261009.py"
    capture = pin(REPO / "tmp" / capture_name, **receipt["method_before"]["capture"])
    spec = pin(REPO / "tmp" / spec_name, **receipt["method_before"]["spec"])
    return {"name": name, "kind": "root_command", "actual_exit": receipt["actual_exit"],
            "native_dispatch": receipt["native_dispatch"], "originals": evidence,
            "method": method, "capture": capture, "spec": spec}

def outer_stage(name: str, size: int, sha: str, has_inner: bool) -> dict:
    folder = REPO / OUTER_BASE / name
    evidence, receipt = triplet(folder, size, sha)
    assert receipt["schema"] == "issue18-i04-var09-root-review-proof/v100"
    assert receipt["actual_exit"] == 0 and receipt["native_dispatch"] is False
    argv = receipt["argv"]
    method = pin(Path(argv[4]), **receipt["method_before"]["review_method"])
    capture = pin(REPO / "tmp/i04-var09-root-review-capture-v100-20261008.py",
                  **receipt["method_before"]["root_capture"])
    inner = extra_inner(folder / "stdout.bin", has_inner)
    return {"name": name, "kind": "generic_outer", "actual_exit": 0,
            "native_dispatch": False, "originals": evidence, "method": method,
            "capture": capture, "inner": inner}

def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--candidate", required=True)
    args = parser.parse_args()
    destination = controlled(Path(args.candidate))
    assert destination.parent == REPO / "tmp" and not destination.exists()
    assert len(COMMAND) == 15 and len(OUTER) == 21
    stages = [command_stage(*row) for row in COMMAND]
    stages += [outer_stage(*row) for row in OUTER]
    folder = REPO / DIAGNOSTIC[0]
    diagnostic, receipt = triplet(folder, DIAGNOSTIC[1], DIAGNOSTIC[2])
    assert receipt["actual_exit"] == 0 and receipt["native_dispatch"] is False
    stages.append({"name": folder.name, "kind": "ps5_diagnostic", "actual_exit": 0,
                   "native_dispatch": False, "originals": diagnostic,
                   "method": pin(Path(receipt["argv"][5]), **receipt["method_before"]["method"]),
                   "capture": pin(REPO / "tmp/i05-var04-root-command-capture-v103-20261009.py",
                                  **receipt["method_before"]["capture"]),
                   "spec": pin(REPO / "tmp/i05-var07-root-ps5-diagnostic-spec-v100-20261009-01.json",
                               **receipt["method_before"]["spec"])})
    assert len(stages) == 37
    seals = [{"role": role, **pin(REPO / relative, size, sha)} for role, relative, size, sha in SEALS]
    environment_seal = json_file(REPO / "tmp/i05-var07-root-local-environment-failure-recovery-seal-v101-20261009-01.json")
    assert environment_seal["native_dispatch"] is False and environment_seal["native_runs"] == 0
    assert len(environment_seal["private_clone_files"]) == 11
    clone_pins = [pin(Path(row["path"]), row["bytes"], row["sha256"])
                  for row in environment_seal["private_clone_files"]]
    assert len({row["path"] for row in clone_pins}) == 11
    record = {"schema": "i05-var07-fixed-publication-proof-plan/v101",
              "package": "I05-var07-scheduled-mission-turnround-v1.0.1",
              "run_id": "i05-var07-turnround-v101-ssh-20261009-01",
              "root_command_capture_count": 15, "generic_outer_capture_count": 21,
              "ps5_diagnostic_capture_count": 1, "native_dispatch_capture_count": 1,
              "failed_local_environment_capture_count": 1,
              "stages": stages, "sealed_context": seals,
              "private_clone_pins": clone_pins,
              "pure_mutant_payload_policy": "Eleven host-only pins from the PS5 recovery seal; do not bulk-copy clone payloads.",
              "publication_policy": "Original host proofs remain mandatory. Later publication captures require a distinct supplement."}
    recheck(record)
    encoded = (json.dumps(record, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
    with destination.open("xb") as handle:
        handle.write(encoded)
    os.chmod(destination, stat.S_IREAD)
    print(json.dumps({"decision": "FINITE_PLAN_CANDIDATE_ONLY", "path": str(destination),
                      "bytes": len(encoded), "sha256": hashlib.sha256(encoded).hexdigest(),
                      "stages": len(stages), "native_dispatch_capture_count": 1}))

if __name__ == "__main__":
    main()
