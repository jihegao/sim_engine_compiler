i05-var07-v101-canonical-inventory-build-20261009T053430101398Z-dce47489
i05-var07-v101-canonical-inventory-review-20261009T053440333555Z-7fd25c2a
i05-var07-v101-canonical-manifest-build-20261009T053702429742Z-0daa48d7
