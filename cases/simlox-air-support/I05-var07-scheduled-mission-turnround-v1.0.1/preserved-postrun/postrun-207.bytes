"""Independent byte and role audit of the finite I05.var07 proof-plan candidate.

Read-only. This does not import the author builder, run a case checker, or infer
semantic acceptance from any captured process result.
"""
from __future__ import annotations

import hashlib
import json
from pathlib import Path
import stat

ROOT = Path(r"C:\Users\user\Documents\Codex\2026-09-29\simlox-c04-deadline\repo")
CANDIDATE = ROOT / "tmp/i05-var07-publication-fixed-proof-plan-v101-20261009-01.json"
CANDIDATE_SIZE = 109288
CANDIDATE_SHA = "66d1eb430a7aa200fcb33a3758634a30cb383395e0bc726bbdfb6a57dc5f7825"
CAPTURE = ROOT / "tmp/i05-var07-root-publication-command-proofs-v100-20261009/i05-var07-v101-publication-fixed-proof-plan-20261009T061325057669Z-ea2cdcc7"
CAPTURE_SIZE = 1783
CAPTURE_SHA = "9e9317c1ac20e71b47b576aef13d2d01d3bdb84219be1ff647b7bec37e95cede"
BUILDER = ROOT / "tmp/i05-var07-publication-author-v101-20261009-01/build_fixed_proof_plan.py"
BUILDER_SHA = "86db60f7255d479213b3dea8b3f9fdf1f9cec26fe4d278a57ad193fe94f93c9b"

COMMAND_NAMES = """i05-var07-v101-local-build-20261009T052024256662Z-bd02050e
i05-var07-v101-local-self-check-20261009T052027328725Z-efb6ab91
