i05-var07-v101-canonical-ssh-preflight-20261009T054418641858Z-8a6f1c6d
i05-var07-v101-converter-ps5-system-modules-v102-20261009T052612431382Z-309a4f30""".splitlines()

OUTER_NAMES = """i05-var07-catalog-git-lf-source-archive-20261009T043850352595Z-89bf7248
i05-var07-external-construction-fresh-guard-20261009T044320027212Z-d21d27c2
i05-var07-independent-prospective-four-artifact-audit-20261009T043452729677Z-5fda4ba7
i05-var07-prospective-pure-materialization-first-child-20261009T043331271222Z-1ca9d470
i05-var07-python-runtime-before-package-freeze-20261009T044855222996Z-36343d8f
