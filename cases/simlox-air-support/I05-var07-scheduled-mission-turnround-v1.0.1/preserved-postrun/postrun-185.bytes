$taskBefore=@(Get-Command Get-FileHash -ErrorAction SilentlyContinue | ForEach-Object { $_.Source })
$taskModules=@(Get-Module -ListAvailable Microsoft.PowerShell.Utility | ForEach-Object {
  [ordered]@{path=$_.Path;version=$_.Version.ToString()}
})
$taskImportError=$null
$taskAfter=@()
