  witness_sha256=$taskWitnessHash;import_error=$taskImportError;native_dispatch=$false
} | ConvertTo-Json -Depth 5 -Compress
if ($taskImportError -or $taskWitnessHash -cne '9f5ea717969fc2eb44907f1b2f8146552046e09a95ed6205b9245656a0c9f16b') {
