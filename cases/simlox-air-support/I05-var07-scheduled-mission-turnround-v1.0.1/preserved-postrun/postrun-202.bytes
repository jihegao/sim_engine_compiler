"""Neutral root capture of one pinned pure publication method; no native dispatch."""
from pathlib import Path
import datetime as dt,hashlib,json,stat,subprocess,sys,uuid
R=Path(__file__).resolve().parents[1]
C=R/'cases/simlox-air-support/I05-var07-scheduled-mission-turnround-v1.0.1'
E=R/'tmp/i05-var07-publication-author-v101-20261009-01'
def pin(p):
 b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def guard(p):
 assert p.is_absolute()
 for a in [p,*p.parents]:
  assert not a.is_symlink() and not a.is_junction()
  if a.exists():assert not a.stat().st_file_attributes&0x400
assert len(sys.argv)==3
P=Path(sys.argv[1]).absolute();guard(P)
assert P.is_relative_to(R/'tmp') and P.stat().st_file_attributes==33 and pin(P)['sha256']==sys.argv[2]
def pairs(items):
 d={}
 for k,v in items:assert k not in d;d[k]=v
 return d
def bad(x):raise AssertionError(x)
s=json.loads(P.read_bytes().decode('utf-8'),object_pairs_hook=pairs,parse_constant=bad)
assert type(s) is dict and set(s)=={'schema','label','method','method_pin','arguments','native_dispatch'}
assert s['schema']=='i05-var07-publication-root-command-spec/v100' and s['native_dispatch'] is False
label=s['label'];assert type(label) is str and label and all(x.isalnum() or x=='-' for x in label)
m=Path(s['method']).absolute();guard(m)
assert m.suffix=='.py' and m.stat().st_file_attributes==33 and pin(m)==s['method_pin']
assert m.parent==E or m==C/'make_evidence_index.py' or (m.parent==R/'tmp' and m.name.startswith('i05-var07-independent-'))
assert type(s['arguments']) is list and all(type(x) is str for x in s['arguments'])
assert pin(Path(sys.executable))=={'bytes':106448,'sha256':'10d845f50a2af64e3500bb2fcb348b5bc98a75d8ddada63e45ba1da6a1fc79d1'}
assert Path(__file__).stat().st_file_attributes==33
argv=[sys.executable,'-X','utf8','-B',str(m)]+s['arguments']
before={'capture':pin(Path(__file__)),'spec':pin(P),'method':pin(m)}
O=R/'tmp/i05-var07-root-publication-command-proofs-v100-20261009'/(label+'-'+dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')+'-'+uuid.uuid4().hex[:8])
guard(O);O.mkdir(parents=True,exist_ok=False)
start=dt.datetime.now(dt.timezone.utc).isoformat()
with (O/'stdout.bin').open('xb') as out,(O/'stderr.bin').open('xb') as err:
 code=subprocess.run(argv,cwd=R,stdout=out,stderr=err).returncode
after={'capture':pin(Path(__file__)),'spec':pin(P),'method':pin(m)}
d={'schema':'i05-var07-publication-root-command-proof/v100','argv':argv,'started_utc':start,'completed_utc':dt.datetime.now(dt.timezone.utc).isoformat(),'native_dispatch':False,'actual_exit':code,'method_before':before,'method_after':after,'streams':{name:pin(O/name) for name in ('stdout.bin','stderr.bin')}}
F=O/'receipt.json'
with F.open('xb') as f:f.write((json.dumps(d,indent=2)+'\n').encode())
for f in O.iterdir():f.chmod(stat.S_IREAD)
print(json.dumps({'receipt':str(F),**pin(F),'actual_exit':code,'method_unchanged':before==after,'native_dispatch':False,'streams':d['streams']}))
for name in ('stdout.bin','stderr.bin'):
 b=(O/name).read_bytes()
 if b:print(b.decode('utf-8-sig','replace')[:12000])
assert before==after
raise SystemExit(code)
