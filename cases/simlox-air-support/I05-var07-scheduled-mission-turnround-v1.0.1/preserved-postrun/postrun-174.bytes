"""Root absent-only byte promotion of independent receipt-bound approval and scope."""
from pathlib import Path
import hashlib,json,stat
R=Path(__file__).resolve().parents[1]
C=R/'cases/simlox-air-support/I05-var07-scheduled-mission-turnround-v1.0.1'
M=C/'prelaunch-manifest.json'
O=R/'tmp/i05-var07-root-prelaunch-promotion-proof-v101-20261009-01'
PAIRS=[(R/'tmp/i05-var07-independent-prelaunch-go-v101-20261009.json',C/'review/independent-prelaunch-go.json',1184,'98207d3bc891f1254063a647d3bdb3e1159e79f59cfdb540b9c4dfea7937e180'),(R/'tmp/i05-var07-independent-prelaunch-scope-go-v101-20261009.md',C/'review/independent-prelaunch-scope-2026-10-09.md',2968,'e5806cb96172e29231f401ab798187391424ea39ceb5a3bed3282a73e296b799')]
def pin(p):
 b=p.read_bytes();s=p.stat();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest(),'mode':stat.S_IMODE(s.st_mode),'attributes':s.st_file_attributes}
def guard(p):
 assert p.is_absolute()
 for a in [p,*p.parents]:
  assert not a.is_symlink() and not a.is_junction()
  if a.exists():assert not a.stat().st_file_attributes&0x400
for p in (M,O,R/'tmp/i05-var07-native-v101-20261009-01'):guard(p)
assert not (R/'tmp/i05-var07-native-v101-20261009-01').exists() and not O.exists()
assert pin(M)=={'bytes':58846,'sha256':'8d94a4def9075796d405f630dda7520e6ef60367668d5bbacd06115249af1d06','mode':292,'attributes':33}
manifest=json.loads(M.read_bytes());assert len(manifest['source_files'])==144
for s,t,size,sha in PAIRS:
 guard(s);guard(t);assert not t.exists()
 assert pin(s)=={'bytes':size,'sha256':sha,'mode':292,'attributes':33}
A=json.loads(PAIRS[0][0].read_bytes())
assert len(A)==14 and A['decision']=='GO_PRELAUNCH' and A['schema']=='i05-var07-independent-prelaunch-go/v101'
assert A['manifest_sha256']==pin(M)['sha256'] and A['run_id']==manifest['run_id'] and A['native_run_directory']==manifest['native_run_directory']
F=C/A['preflight_relative_path'];guard(F)
assert pin(F)=={'bytes':49896,'sha256':A['preflight_sha256'],'mode':292,'attributes':33}
assert A['preflight_sha256']=='7f8f56d50228d6e11e4ecc8473ffaef5215a7270e57bc534e84fcb6d7d07da50'
D=R/'tmp/i05-var07-root-command-proofs-v102-20261009/i05-var07-v101-canonical-preflight-review-20261009T054556148018Z-ea5dfec9/receipt.json'
guard(D);assert pin(D)=={'bytes':1684,'sha256':'00079da041d9e99b24e93169aff9bc0c553d938991d283e397027bf739105e32','mode':292,'attributes':33}
audit=json.loads(D.read_bytes());assert audit['actual_exit']==0 and type(audit['actual_exit']) is int and audit['native_dispatch'] is False and audit['method_before']==audit['method_after']
for name,expected in audit['streams'].items():
 guard(D.parent/name);actual=pin(D.parent/name);assert {k:actual[k] for k in ('bytes','sha256')}==expected and actual['attributes']==33
assert (D.parent/'stderr.bin').read_bytes()==b''
assert json.loads((D.parent/'stdout.bin').read_bytes())=={'decision':'PASS_ACTUAL_ZERO_NATIVE_PREFLIGHT'}
for row in manifest['source_files']:guard(Path(row['path']))
before={row['key']:pin(Path(row['path'])) for row in manifest['source_files']}
for row in manifest['source_files']:assert before[row['key']]=={k:row[k] for k in ('bytes','sha256','mode','attributes')}
O.mkdir(exist_ok=False);copied=[];error=None
try:
 for s,t,size,sha in PAIRS:
  guard(s);guard(t)
  with t.open('xb') as f:f.write(s.read_bytes())
  t.chmod(stat.S_IREAD);guard(t);assert pin(t)==pin(s)
  copied.append({'source':str(s),'target':str(t),'pin':pin(t)})
except Exception as exc:error=repr(exc)
after={row['key']:pin(Path(row['path'])) for row in manifest['source_files']}
receipt={'schema':'i05-var07-root-prelaunch-promotion/v101','audit_receipt':str(D),'audit_pin':pin(D),'preflight':str(F),'preflight_pin':pin(F),'copied':copied,'source_before':before,'source_after':after,'source_stable':before==after,'error':error,'native_dispatch':False}
P=O/'receipt.json'
with P.open('xb') as f:f.write((json.dumps(receipt,indent=2)+'\n').encode())
P.chmod(stat.S_IREAD)
print(json.dumps({'receipt':str(P),**pin(P),'source_stable':before==after,'copied':len(copied),'error':error}))
assert error is None and before==after and len(copied)==2
