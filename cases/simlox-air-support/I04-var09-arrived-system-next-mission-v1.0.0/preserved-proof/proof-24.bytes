"""One-time binary capture for the inert publication-method custody copy."""
from __future__ import annotations
import hashlib
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO=Path(__file__).resolve().parent.parent
METHOD=REPO/'cases/simlox-air-support/I04-var09-arrived-system-next-mission-v1.0.0/copy_root_publication_methods.py'
OUT=REPO/'tmp/i04-var09-copy-root-publication-20261008-01'

def pin(data):
    return {'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}

assert not OUT.exists()
before=pin(METHOD.read_bytes())
OUT.mkdir()
started=datetime.now(timezone.utc).isoformat()
argv=[sys.executable,'-B',str(METHOD),'--write']
completed=subprocess.run(argv,cwd=REPO,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False)
(OUT/'stdout.bin').write_bytes(completed.stdout)
(OUT/'stderr.bin').write_bytes(completed.stderr)
after=pin(METHOD.read_bytes())
receipt={'schema':'i04-var09-author-binary-capture/v1','action':'copy-root-publication-write',
         'argv':argv,'started_utc':started,'completed_utc':datetime.now(timezone.utc).isoformat(),
         'actual_exit':completed.returncode,'method_before':before,'method_after':after,
         'streams':{'stdout.bin':pin(completed.stdout),'stderr.bin':pin(completed.stderr)},
         'native_calls':0,'catalog_mutations':0,'git_mutations':0}
(OUT/'receipt.json').write_bytes((json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode())
assert completed.returncode == 0 and completed.stderr == b'' and before == after
print(json.dumps({'receipt':str(OUT/'receipt.json'),'receipt_pin':pin((OUT/'receipt.json').read_bytes()),
                  'stdout_pin':pin(completed.stdout),'stderr_pin':pin(completed.stderr)},sort_keys=True))
