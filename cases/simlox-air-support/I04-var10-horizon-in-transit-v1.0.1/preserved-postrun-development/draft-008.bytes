DEVELOPMENT_ROWS = (
    ("draft-000.bytes", "executed_first_preflight_generator_source", "decoded_tool_output_only_no_original_binary_receipt"),
    ("draft-001.bytes", "executed_first_preflight_map_14308", "decoded_tool_output_only_no_original_binary_receipt"),
    ("draft-002.bytes", "intermediate_preflight_status_literal_failure", "decoded_tool_output_only_no_original_binary_receipt"),
    ("draft-003.bytes", "executed_first_context_copier_98_rows", "superseded_copier_original_bytes_preserved"),
    ("draft-004.bytes", "executed_first_context_original_map_98_rows", "superseded_map_original_bytes_preserved"),
