    "i04-var10-v101-independent-fixture-20261008T134722688720Z-2b9cce89",
    "i04-var10-v101-independent-selfcheck-20261008T134724258939Z-ff550bde",
    "i04-var10-v101-copy-pure-20261008T134851723556Z-ac3831d6",
