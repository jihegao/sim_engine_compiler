"""One approved canonical inventory write, equal to the independently audited candidate."""
from pathlib import Path
import hashlib, json, subprocess, sys
R=Path(__file__).resolve().parents[1]
P=R/'cases/simlox-air-support/I04-var10-horizon-in-transit-v1.0.1'
C=R/'tmp/i04-var10-v101-inventory-candidate-20261008-01.json'
G=R/'tmp/i04-var10-independent-inventory-candidate-go-v101-20261008.json'
W=P/'make_source_inventory.py'
T=P/'source-inventory.json'
def pin(p):
    b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
assert pin(G)=={'bytes':1471,'sha256':'ba9b138bc12af28b94c1b424c08f47242685f48d66a7957ad1a5406d30aaa2d6'}
assert json.loads(G.read_text(encoding='utf-8-sig'))['decision']=='GO_INVENTORY_WRITE'
assert pin(C)=={'bytes':43251,'sha256':'3f5609725b222c11ea322228b9f5b5bddce7e78bee3ca864e8803292803a9844'}
assert pin(W)=={'bytes':7632,'sha256':'1d8dff0d13b5a0deaa46b603578db5d7f59bbeaef8285b85882e4a72b7b06300'}
assert not T.exists()
def check():
    for row in json.loads(C.read_text(encoding='utf-8-sig'))['source_files']:
        p=Path(row['path']);assert p.stat().st_file_attributes & 1
        assert pin(p)=={k:row[k] for k in ('bytes','sha256')}
check()
code=subprocess.run([sys.executable,'-X','utf8','-B',str(W),'--write'],cwd=P).returncode
check()
if code==0:
    assert T.read_bytes()==C.read_bytes()
    T.chmod(0o444)
    print(json.dumps({'canonical_inventory':str(T),**pin(T),'native_calls':0}))
raise SystemExit(code)
