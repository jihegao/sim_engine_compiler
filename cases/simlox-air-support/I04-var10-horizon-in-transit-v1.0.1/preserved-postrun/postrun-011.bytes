"""Original independent audit of one external source inventory candidate."""
from pathlib import Path
import hashlib, json, subprocess, sys
R=Path(__file__).resolve().parents[1]
P=R/'cases/simlox-air-support/I04-var10-horizon-in-transit-v1.0.1'
C=R/'tmp/i04-var10-v101-inventory-candidate-20261008-01.json'
W=P/'review/independent_replay.py'
def pin(p):
    b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
expected={'bytes':43251,'sha256':'3f5609725b222c11ea322228b9f5b5bddce7e78bee3ca864e8803292803a9844'}
reader={'bytes':75172,'sha256':'0109ac2d539c625e84df2db3f4c9bf1cb045ead2dfd5dc40765022cef46efea5'}
def check():
    assert pin(C)==expected and pin(W)==reader
    assert C.stat().st_file_attributes & 1 and W.stat().st_file_attributes & 1
    for row in json.loads(C.read_text(encoding='utf-8-sig'))['source_files']:
        path=Path(row['path']);assert path.stat().st_file_attributes & 1
        assert pin(path)=={k:row[k] for k in ('bytes','sha256')}
check()
code=subprocess.run([sys.executable,'-X','utf8','-B',str(W),'--pure-inventory-candidate',str(C)],cwd=P).returncode
check()
raise SystemExit(code)
