"""Create only an external frozen 114-source candidate; no canonical write."""
from pathlib import Path
import hashlib, json, subprocess, sys
R=Path(__file__).resolve().parents[1]
P=R/'cases/simlox-air-support/I04-var10-horizon-in-transit-v1.0.1'
W=P/'make_source_inventory.py'
O=R/'tmp/i04-var10-v101-inventory-candidate-20261008-01.json'
def pin(p):
    b=p.read_bytes();return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
expected={'bytes':7632,'sha256':'1d8dff0d13b5a0deaa46b603578db5d7f59bbeaef8285b85882e4a72b7b06300'}
assert pin(W)==expected and W.stat().st_file_attributes & 1
assert not O.exists() and not (P/'source-inventory.json').exists()
code=subprocess.run([sys.executable,'-X','utf8','-B',str(W),'--candidate',str(O)],cwd=P).returncode
assert pin(W)==expected
if code==0:
    document=json.loads(O.read_text(encoding='utf-8-sig'))
    assert document['source_count']==len(document['source_files'])==114
    assert document['provisional'] is False
    for row in document['source_files']:
        path=Path(row['path']);assert path.stat().st_file_attributes & 1
        assert pin(path)=={k:row[k] for k in ('bytes','sha256')}
    O.chmod(0o444)
    print(json.dumps({'candidate':str(O),**pin(O),'native_calls':0}))
raise SystemExit(code)
