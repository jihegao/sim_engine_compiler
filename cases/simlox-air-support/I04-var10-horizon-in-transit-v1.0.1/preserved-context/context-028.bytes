                                    'bytes': 1363, 'sha256': 'bf7b9e607f5353cb17c471c473b7d427ac21c4528f28c9bebfc9c11604b2e052'},
        'excluded_v100': {
            'reason': 'Static NO_GO before SSH/native: frozen 1244-cell values but two result-table instance labels retained 36.00 from parent rather than hour-11 RCEND.',
            'prospective_artifacts': {name: {'path': str(V100 / name), **wanted} for name, wanted in old.items()},
            'excluded_case_inventory': {'path': 'tmp/i04-var10-v100-excluded-construction-inventory-20261008.json',
