    {
      "task_id": "T04",
      "title": "缩短截止并取消旧准备事件",
      "task_type": "modify",
      "requirements": [
        {
          "id": "T04-R01",
          "text": "使用base_model，只把任务tight允许延误从0.3小时改成0.29小时，其余输入全部保持。"
        },
        {
          "id": "T04-R02",
          "text": "截止时未能准备完整编队就取消tight，释放其人员与飞机；取消前已经安排的旧完成事件不能继续改变飞机状态或重复释放资源。"
        },
        {
          "id": "T04-R03",
          "text": "保留任务recovery独立执行，其通知时刻恰为tight的新截止；取消释放的飞机可以重新使用。"
        }
      ],
      "base_model": {
