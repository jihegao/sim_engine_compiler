    "constraints": "Use exactly specified entities and stable IDs. No hidden extra resources/aircraft or omitted missions. All output times are hours. Fully return amended model for modify tasks."
  },
  "tasks": [
    {
      "task_id": "T01",
      "title": "共享资源下的三机准备",
      "task_type": "create",
      "requirements": [
        {
          "id": "T01-R01",
          "text": "创建模型：时域4小时，每0.1小时报告；飞机 raven-1、raven-2、raven-3，类型均为utility，使用公共默认飞机属性。"
        },
        {
          "id": "T01-R02",
          "text": "资源staff总容量为2。过程prep的scalar为0.2小时，只有inspection步骤，历时0.2小时，每架独立申请staff 1个；占用直到该步骤结束才释放。"
        },
        {
          "id": "T01-R03",
          "text": "任务patrol在1.8小时通知、计划2小时起飞，允许延误0.3小时，飞行0.7小时，priority=1；需要3架utility全部准备完成，过程prep，无任务依赖。"
        }
      ]
    },
    {
      "task_id": "T02",
      "title": "分钟输入转换与周转",
      "task_type": "create",
      "requirements": [
        {
          "id": "T02-R01",
          "text": "所有以下时间以分钟叙述，输出IR统一用小时。时域180分钟、报告间隔6分钟；只有minute-1飞机，类型utility。"
        },
        {
          "id": "T02-R02",
          "text": "无人员或设备资源；过程prep无步骤分解，scalar为18分钟。任务minute-flight在第57分钟通知、第75分钟起飞、不允许延误、飞行42分钟；需1架utility，priority=1，过程prep，无依赖。"
        },
        {
          "id": "T02-R03",
          "text": "minute-1每次成功返航后周转6分钟；其余属性取公共默认。"
        }
      ]
    },
    {
      "task_id": "T03",
      "title": "修改准备过程为显式串行步骤",
      "task_type": "modify",
      "requirements": [
        {
          "id": "T03-R01",
          "text": "使用给定base_model，只有以下修改；未提到的字段保持不变。"
        },
        {
          "id": "T03-R02",
          "text": "过程prep保留scalar_hours=0.9，但新增按序串行执行的safety和warmup两步骤；safety为0.12小时、占staff 1个，warmup为0.18小时、不占任何资源。显式步骤总时长替代scalar执行时长，不能把scalar再次加到步骤上。"
        },
        {
          "id": "T03-R03",
          "text": "准备完成且达到任务计划起飞时间后才能起飞；staff在safety结束时释放。"
        }
      ],
      "base_model": {
        "horizon_hours": 4,
        "report_interval_hours": 0.1,
        "rng_profile": "none",
        "aircraft": [
          {
            "id": "serial-1",
